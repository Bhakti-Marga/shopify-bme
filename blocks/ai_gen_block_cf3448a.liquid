{% doc %}
  @prompt
    Two images in two columns side by side each with 16px rounded corner and content inside each which has a H2 title a text under of 16px and a button 100 rounded corner and type of 16px. Both images sit inside a container which has left/right and top/bottom padding of 40px. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-images-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
  }

  .ai-two-column-images__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    width: 100%;
  }

  .ai-two-column-images__column-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-two-column-images__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
  }

  .ai-two-column-images__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-two-column-images__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-two-column-images__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-two-column-images__content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    background: {{ block.settings.content_background_color }};
    color: {{ block.settings.content_text_color }};
  }

  .ai-two-column-images__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_margin_bottom }}px 0;
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.content_text_color }};
  }

  .ai-two-column-images__text-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.text_margin_bottom }}px 0;
    font-size: 16px;
    line-height: 1.5;
    color: {{ block.settings.content_text_color }};
  }

  .ai-two-column-images__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 100px;
    font-size: 16px;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-two-column-images__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-images__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_column_gap }}px;
    }
  }
{% endstyle %}

<two-column-images-{{ ai_gen_id }} class="ai-two-column-images-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-images__container-{{ ai_gen_id }}">
    <div class="ai-two-column-images__column-{{ ai_gen_id }}">
      <div class="ai-two-column-images__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_1 %}
          <img
            src="{{ block.settings.image_1 | image_url: width: 1000 }}"
            alt="{{ block.settings.image_1.alt | escape }}"
            class="ai-two-column-images__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_1.width }}"
            height="{{ block.settings.image_1.height }}"
          >
        {% else %}
          <div class="ai-two-column-images__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <div class="ai-two-column-images__content-{{ ai_gen_id }}">
        {% if block.settings.title_1 != blank %}
          <h2 class="ai-two-column-images__title-{{ ai_gen_id }}">{{ block.settings.title_1 }}</h2>
        {% endif %}
        {% if block.settings.text_1 != blank %}
          <p class="ai-two-column-images__text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</p>
        {% endif %}
        {% if block.settings.button_text_1 != blank %}
          <a href="{{ block.settings.button_link_1 }}" class="ai-two-column-images__button-{{ ai_gen_id }}">
            {{ block.settings.button_text_1 }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-two-column-images__column-{{ ai_gen_id }}">
      <div class="ai-two-column-images__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_2 %}
          <img
            src="{{ block.settings.image_2 | image_url: width: 1000 }}"
            alt="{{ block.settings.image_2.alt | escape }}"
            class="ai-two-column-images__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_2.width }}"
            height="{{ block.settings.image_2.height }}"
          >
        {% else %}
          <div class="ai-two-column-images__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <div class="ai-two-column-images__content-{{ ai_gen_id }}">
        {% if block.settings.title_2 != blank %}
          <h2 class="ai-two-column-images__title-{{ ai_gen_id }}">{{ block.settings.title_2 }}</h2>
        {% endif %}
        {% if block.settings.text_2 != blank %}
          <p class="ai-two-column-images__text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</p>
        {% endif %}
        {% if block.settings.button_text_2 != blank %}
          <a href="{{ block.settings.button_link_2 }}" class="ai-two-column-images__button-{{ ai_gen_id }}">
            {{ block.settings.button_text_2 }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</two-column-images-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoColumnImages{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('two-column-images-{{ ai_gen_id }}', TwoColumnImages{{ ai_gen_id }});
  })();
</script>

