      "default": "Name"
    },
    {
      "type": "inline_richtext",
      "id": "name_placeholder",
      "label": "Name placeholder"
    },
    {
      "type": "inline_richtext",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "inline_richtext",
      "id": "email_placeholder",
      "label": "Email placeholder"
    },
    {
      "type": "inline_richtext",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Phone"
    },
    {
      "type": "inline_richtext",
      "id": "phone_placeholder",
      "label": "Phone placeholder"
    },
    {
      "type": "inline_richtext",
      "id": "message_label",
      "label": "Message label",
      "default": "Message"
    },
    {
      "type": "inline_richtext",
      "id": "message_placeholder",
      "label": "Message placeholder"
    },
    {
      "type": "inline_richtext",
      "id": "button_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
