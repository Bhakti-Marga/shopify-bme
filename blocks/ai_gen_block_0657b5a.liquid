{% doc %}
  @prompt
    A contact form which is in a container in the center middle of the screen with 16pt rounded corners with background color #faf6ee and card color white. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-form-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background-color: #faf6ee;
    padding: 20px;
    width: 100%;
  }

  .ai-contact-form-container-{{ ai_gen_id }} {
    background-color: #ffffff;
    border-radius: 16px;
    padding: 40px;
    max-width: 600px;
    width: 100%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-contact-form-heading-{{ ai_gen_id }} {
    margin: 0 0 24px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: center;
  }

  .ai-contact-form-subtext-{{ ai_gen_id }} {
    margin: 0 0 32px;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  .ai-contact-form-field-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-contact-form-label-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    color: {{ block.settings.label_color }};
    font-weight: 500;
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
    color: {{ block.settings.input_text_color }};
    background-color: {{ block.settings.input_background_color }};
    box-sizing: border-box;
  }

  .ai-contact-form-input-{{ ai_gen_id }}:focus,
  .ai-contact-form-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-contact-form-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-contact-form-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-contact-form-success-{{ ai_gen_id }} {
    padding: 12px 16px;
    background-color: {{ block.settings.success_bg_color }};
    color: {{ block.settings.success_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 20px;
    text-align: center;
  }

  .ai-contact-form-error-{{ ai_gen_id }} {
    padding: 12px 16px;
    background-color: {{ block.settings.error_bg_color }};
    color: {{ block.settings.error_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-container-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-contact-form-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }
  }
{% endstyle %}

<div class="ai-contact-form-wrapper-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-form-container-{{ ai_gen_id }}">
    {%- if block.settings.heading != blank -%}
      <h2 class="ai-contact-form-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {%- endif -%}

    {%- if block.settings.subtext != blank -%}
      <div class="ai-contact-form-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</div>
    {%- endif -%}

    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}
        <div class="ai-contact-form-success-{{ ai_gen_id }}" id="ai-contact-form-success-{{ ai_gen_id }}">
          {{ block.settings.success_message }}
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="ai-contact-form-error-{{ ai_gen_id }}" id="ai-contact-form-error-{{ ai_gen_id }}">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="ai-contact-form-field-{{ ai_gen_id }}">
        <label for="ai-contact-name-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
          {{ block.settings.name_label }}
        </label>
        <input
          type="text"
          id="ai-contact-name-{{ ai_gen_id }}"
          name="contact[name]"
          class="ai-contact-form-input-{{ ai_gen_id }}"
          autocomplete="name"
          value="{% if form.name %}{{ form.name }}{% endif %}"
          placeholder="{{ block.settings.name_placeholder }}"
        >
      </div>

      <div class="ai-contact-form-field-{{ ai_gen_id }}">
        <label for="ai-contact-email-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
          {{ block.settings.email_label }}
        </label>
        <input
          type="email"
          id="ai-contact-email-{{ ai_gen_id }}"
          name="contact[email]"
          class="ai-contact-form-input-{{ ai_gen_id }}"
          autocomplete="email"
          value="{% if form.email %}{{ form.email }}{% endif %}"
          placeholder="{{ block.settings.email_placeholder }}"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="ai-contact-form-error-{{ ai_gen_id }}"
          {% endif %}
        >
      </div>

      <div class="ai-contact-form-field-{{ ai_gen_id }}">
        <label for="ai-contact-phone-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
          {{ block.settings.phone_label }}
        </label>
        <input
          type="tel"
          id="ai-contact-phone-{{ ai_gen_id }}"
          name="contact[phone]"
          class="ai-contact-form-input-{{ ai_gen_id }}"
          autocomplete="tel"
          value="{% if form.phone %}{{ form.phone }}{% endif %}"
          placeholder="{{ block.settings.phone_placeholder }}"
        >
      </div>

      <div class="ai-contact-form-field-{{ ai_gen_id }}">
        <label for="ai-contact-message-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
          {{ block.settings.message_label }}
        </label>
        <textarea
          id="ai-contact-message-{{ ai_gen_id }}"
          name="contact[body]"
          class="ai-contact-form-textarea-{{ ai_gen_id }}"
          placeholder="{{ block.settings.message_placeholder }}"
          required
        >{% if form.body %}{{ form.body }}{% endif %}</textarea>
      </div>

      <button type="submit" class="ai-contact-form-button-{{ ai_gen_id }}">
        {{ block.settings.button_label }}
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
