    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input text",
