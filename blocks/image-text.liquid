<div class="image-text flex flex-col justify-center items-center">
  {% if block.settings.image != blank %}
    <div class="image-text__image" style="width: {{ block.settings.width }};">
      {% render 'lazy-image', image: block.settings.image, image_desktop: block.settings.image_desktop, loading: block.settings.load %}
    </div>
  {% endif %}
  {% if block.settings.text != blank %}
    <p class="image-text__text" style="color: {{ block.settings.text_color }};">
      {{ block.settings.text }}
    </p>
  {% endif %}
</div>

{% schema %}
  {
    "name": "Image - Text",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image (Mobile - Required)"
      },
      {
        "type": "image_picker",
        "id": "image_desktop",
        "label": "Image (Desktop)"
      },
      {
        "type": "select",
        "id": "load",
        "label": "Image Loading Type",
        "options": [
          {
            "value": "lazy",
            "label": "Lazy"
          },
          {
            "value": "eager",
            "label": "Eager"
          }
        ],
        "default": "lazy"
      },
      {
        "type": "text",
        "id": "image_width",
        "label": "Image Width",
        "info": "Use 'px', '%', or 'vw' values (ex. 40px)"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default": "#000000"
      }
    ]
  }
{% endschema %}
