{% doc %}
  @prompt
    Two images side by side in two columns. They are inside a container which has 40px padding on the top, bottom, left and right. The images have 16px rounded corners. On top of the images there is a content block which is positioned at the top of the image and middle. The content block is formed by a heading title which is styled to H2; text under which is 16px; and a white button with 100px rounded corners and black 16pt text., Add padding above the content block
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-images-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-two-column-images__container-{{ ai_gen_id }} {
    padding: 40px;
    background-color: {{ block.settings.container_bg_color }};
  }

  .ai-two-column-images__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-two-column-images__column-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-two-column-images__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
  }

  .ai-two-column-images__image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
  }

  .ai-two-column-images__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: #f4f4f4;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-two-column-images__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-two-column-images__content-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.content_top_padding }}px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    padding: {{ block.settings.content_padding }}px;
    text-align: center;
    z-index: 2;
  }

  .ai-two-column-images__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    font-weight: 600;
  }

  .ai-two-column-images__text-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.button_spacing }}px 0;
    line-height: 1.5;
  }

  .ai-two-column-images__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: 16px;
    border-radius: 100px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-two-column-images__button-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-images__container-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-two-column-images__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | divided_by: 2 }}px;
    }

    .ai-two-column-images__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<two-column-images-{{ ai_gen_id }} class="ai-two-column-images-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-images__container-{{ ai_gen_id }}">
    <div class="ai-two-column-images__grid-{{ ai_gen_id }}">
      {% for i in (1..2) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign heading_key = 'heading_' | append: i
          assign text_key = 'text_' | append: i
          assign button_text_key = 'button_text_' | append: i
          assign button_url_key = 'button_url_' | append: i

          assign image = block.settings[image_key]
          assign heading = block.settings[heading_key]
          assign text = block.settings[text_key]
          assign button_text = block.settings[button_text_key]
          assign button_url = block.settings[button_url_key]
        %}

        <div class="ai-two-column-images__column-{{ ai_gen_id }}">
          <div class="ai-two-column-images__image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 1000 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-two-column-images__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="ai-two-column-images__content-{{ ai_gen_id }}">
              {% if heading != blank %}
                <h2 class="ai-two-column-images__heading-{{ ai_gen_id }}">{{ heading }}</h2>
              {% endif %}

              {% if text != blank %}
                <div class="ai-two-column-images__text-{{ ai_gen_id }}">{{ text }}</div>
              {% endif %}

              {% if button_text != blank %}
                <a
                  href="{{ button_url | default: '#' }}"
                  class="ai-two-column-images__button-{{ ai_gen_id }}"
                >
                  {{ button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</two-column-images-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoColumnImages{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('two-column-images-{{ ai_gen_id }}', TwoColumnImages{{ ai_gen_id }});
  })();
</script>

