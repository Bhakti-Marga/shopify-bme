{% doc %}
  @prompt
    Full screen video with content block on top which consists of a title header in style H2, a text, and a white button with 100px rounded corner and black text of 16pt. Give editability options for the text style and position of the content block (left, center, etc), Make it so I can upload / choose a video from my content
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fullscreen-video-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: block;
  }

  .ai-fullscreen-video__video-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-fullscreen-video__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-fullscreen-video__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666666;
    font-size: 18px;
  }

  .ai-fullscreen-video__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    pointer-events: none;
  }

  .ai-fullscreen-video__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    justify-content: {{ block.settings.horizontal_alignment }};
    padding: 40px;
    z-index: 2;
  }

  .ai-fullscreen-video__content-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-fullscreen-video__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    font-weight: {{ block.settings.title_weight }};
    line-height: 1.2;
  }

  .ai-fullscreen-video__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    line-height: 1.6;
  }

  .ai-fullscreen-video__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: {{ block.settings.button_text_weight }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-fullscreen-video__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-fullscreen-video__content-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-fullscreen-video__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-fullscreen-video__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }

    .ai-fullscreen-video__button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_text_size }}px * 0.9);
    }
  }
{% endstyle %}

<fullscreen-video-{{ ai_gen_id }} class="ai-fullscreen-video-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-fullscreen-video__video-wrapper-{{ ai_gen_id }}">
    {% if block.settings.video != blank %}
      {{
        block.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          class: 'ai-fullscreen-video__video-' | append: ai_gen_id,
          image_size: '2000x'
      }}
    {% elsif block.settings.video_url != blank %}
      <video
        class="ai-fullscreen-video__video-{{ ai_gen_id }}"
        autoplay
        muted
        loop
        playsinline
        {% if block.settings.video_poster %}
          poster="{{ block.settings.video_poster | image_url: width: 2000 }}"
        {% endif %}
      >
        <source src="{{ block.settings.video_url }}" type="video/mp4">
      </video>
    {% else %}
      <div class="ai-fullscreen-video__placeholder-{{ ai_gen_id }}">
        Add a video from your content or enter a video URL
      </div>
    {% endif %}
  </div>

  <div class="ai-fullscreen-video__overlay-{{ ai_gen_id }}"></div>

  <div class="ai-fullscreen-video__content-{{ ai_gen_id }}">
    <div class="ai-fullscreen-video__content-inner-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-fullscreen-video__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-fullscreen-video__text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_url }}" class="ai-fullscreen-video__button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</fullscreen-video-{{ ai_gen_id }}>

<script>
  (function() {
    class FullscreenVideo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.video = this.querySelector('.ai-fullscreen-video__video-{{ ai_gen_id }}');
        if (this.video && this.video.tagName === 'VIDEO') {
          this.video.play().catch(() => {});
        }
      }
    }

    customElements.define('fullscreen-video-{{ ai_gen_id }}', FullscreenVideo{{ ai_gen_id }});
  })();
</script>

