{% doc %}
  Estilos compartidos (tokens, botones, títulos) para las secciones "Darshan Lanzarote".
  Todo scopado bajo .dv-scope para no chocar con el tema. Renderízalo al inicio de cada sección dl-*.
  @example
  {% render 'dl-styles' %}
{% enddoc %}
{% stylesheet %}
  .dv-scope{
    --navy:#16254c; --navy-deep:#0e1a37; --gold:#d6bf90; --gold-deep:#b89a5e;
    --cream:#f4f0e8; --cream-soft:#faf7f1; --white:#fafaf8; --ink:#1a1a18;
    --muted:#6b6b67; --rule:rgba(22,37,76,.10);
    background:var(--white); color:var(--ink);
    font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased; line-height:1.5;
  }
  .dv-scope *{box-sizing:border-box}
  .dv-scope img{display:block;max-width:100%}
  .dv-scope a{color:inherit;text-decoration:none}
  .dv-scope section{position:relative}
  .dv-pad{padding:88px 0}
  @media (max-width:720px){.dv-pad{padding:60px 0}}
  .dv-sec-title{font-size:clamp(1.65rem,3.2vw,2.6rem);font-weight:600;color:var(--navy);line-height:1.15;letter-spacing:-.01em;margin:0 0 12px}
  .dv-sec-body{font-size:16px;line-height:1.75;color:var(--muted);margin:0}
  .dv-sec-eyebrow{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-deep);font-weight:600;margin:0 0 14px;display:inline-block}
  .dv-eyebrow{display:inline-flex;align-items:center;gap:.75rem;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:18px}
  .dv-eyebrow::before,.dv-eyebrow::after{content:"";width:24px;height:1px;background:var(--gold);opacity:.7}
  .dv-scope .dv-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 26px;border-radius:999px;font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;border:1.5px solid transparent;cursor:pointer;transition:all .18s;line-height:1}
  .dv-scope .dv-btn:hover{transform:translateY(-1px)}
  .dv-scope .dv-btn--gold{background:var(--gold);color:var(--navy)}
  .dv-scope .dv-btn--gold:hover{background:var(--gold-deep);color:#fff}
  .dv-scope .dv-btn--navy{background:var(--navy);color:#fff}
  .dv-scope .dv-btn--navy:hover{background:var(--navy-deep)}
  .dv-scope .dv-btn--outline-white{background:transparent;color:#fff;border-color:rgba(255,255,255,.55)}
  .dv-scope .dv-btn--outline-white:hover{background:#fff;color:var(--navy);border-color:#fff}
  .dv-scope .dv-btn--outline{background:transparent;color:var(--navy);border-color:var(--navy)}
  /* Fix mobile horizontal overflow: the theme's <main> is display:grid, and grid
     items (.shopify-section) default to min-width:auto, so they refuse to shrink
     below their content's min-content and stretch the whole page wider than the
     viewport on mobile (which also breaks the sticky header / hamburger). Let the
     dl section wrappers shrink. Scoped to this page's template. */
  .template--darshan-lanzarote .shopify-section{min-width:0}
  /* Fix mobile 100vh overflow on the Hero Video Signup sections used on this
     page with "Set full screen height" enabled (.screen-height, defined in
     assets/theme.css as .hero-video-signup.screen-height). 100vh is computed
     against the browser's "large" viewport (address bar collapsed), not the
     viewport actually visible on first paint, so the block measures taller
     than the screen and forces extra scroll / a "broken" stacked look on
     load. 100dvh (dynamic viewport height) tracks the real visible viewport.
     Declaring 100vh first, then 100dvh, is the standard progressive-
     enhancement fallback: browsers that understand dvh simply apply the
     later declaration, no @supports needed. Mirrors theme.css's own mobile/
     desktop split (same vars, same 64rem breakpoint) so this only changes
     the viewport unit, not the rest of the calculation. Scoped to this
     page's template. */
  .template--darshan-lanzarote .screen-height{
    min-height:calc(100vh - var(--header-height) - var(--padding-top) - var(--padding-bottom));
    min-height:calc(100dvh - var(--header-height) - var(--padding-top) - var(--padding-bottom));
  }
  @media (min-width:64rem){
    .template--darshan-lanzarote .screen-height{
      min-height:calc(100vh - var(--header-height) - var(--padding-top-desktop) - var(--padding-bottom-desktop));
      min-height:calc(100dvh - var(--header-height) - var(--padding-top-desktop) - var(--padding-bottom-desktop));
    }
  }
  /* Site-wide safety net the theme already relies on elsewhere (see the
     `html, body { overflow-x: hidden; }` rule shipped inside
     sections/BM-event-slider.liquid, which is why pages using that section
     never show a horizontal scrollbar even if some child briefly overflows).
     This page is built entirely from bespoke Seccion__dl-* sections that
     never pull that rule in, so it had no such net. Scoped to the body class
     for this template only, mirroring the pattern above, instead of touching
     html/body globally. */
  body.template--darshan-lanzarote{overflow-x:hidden}
  html:has(body.template--darshan-lanzarote){overflow-x:hidden}
{% endstylesheet %}
