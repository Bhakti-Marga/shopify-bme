<form method="post" action="/cart/add" id="{{ form_id }}" accept-charset="UTF-8" class="form-ddd" enctype="multipart/form-data" data-type="add-to-cart-form">
  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
  <input type="hidden" name="form_type" value="product">
  <input type="hidden" name="utf8" value="✓">

{% if customer %}<h6 class="h6">
  Jai Gurudev {{ customer.first_name }}!</h6>
    {% else %}
    <p>Please LOG IN to be able to track your events.</p>
    {% endif %}
    <br>

{%- assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id -%}
{%- assign firstname = customer.first_name -%}
{%- assign lastname = customer.last_name -%}
{%- assign email = customer.email -%}

  <div class="p-form">
    <div class="ddd">
      <input placeholder="First Name *" id="firstname" type="text" name="properties[firstname]" value="{% if cart_qty == 0 and firstname != "" %}{{ customer.first_name }}{% endif %}" required>
      <label for="firstname">First Name<span style="color: red;">*</span></label>
    </div>
  </div>

  <div class="p-form">
    <div class="ddd">
      <input placeholder="Last Name *" id="lastname" type="text" name="properties[lastname]" value="{% if cart_qty == 0 and lastname != "" %}{{ customer.last_name }}{% endif %}" required>
      <label for="lastname">Last Name<span style="color: red;">*</span></label>
    </div>
  </div>

  <div class="p-form">
    <div class="ddd">
      <input id="email" type="email" placeholder="Email *" name="properties[email]" value="{% if cart_qty == 0 and email != "" %}{{ customer.email }}{% endif %}" required>
      <label for="email">Email<span style="color: red;">*</span></label>
    </div>
  </div>

<div class="ddd">
  <select id="newcomer" class="ddd-select" name="properties[newcomer]" required>
    <option value="">First Time Visit? *</option>
    <option value="Yes">Yes</option>
    <option value="No">No</option>
  </select>
  <p style="color: rgb(38, 69, 109, 0.9); font-size: 15px; margin: 5px 0px 12px 12px;">* First-time visitors are those who have visited the ashram up to 3 times.</p>
</div>

{% if product.metafields.event.interpretation == blank %}
  <div style="display: none;"></div>
{% else %}
<div class="ddd">
  {% assign options = product.metafields.event.interpretation | remove: "[" | remove: "]" | split: "," %}
  <select id="interpretation-language" class="ddd-select" name="properties[interpretation-language]" required>
    <option value="">Interpretation *</option>
    {% for option in options %}
      <option value="{{ option | strip | remove: '"' }}">{{ option | strip | remove: '"' }}</option>
    {% endfor %}
  </select>
</div>
{% endif %}

