<s-drawer id="CartDrawer" position='right' open="[js-open-cart]" close="[js-close-cart">
  <button js-close-cart class="absolute right-md top-20 group">
    <i class='inline-block w-lg transition duration-500 group-hover:rotate-90'>{% render 'icon--close' %}</i>
  </button>
  {% render 'cart' %}
</s-drawer>
