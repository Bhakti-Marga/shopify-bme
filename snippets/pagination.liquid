{% comment %}
    Renders a set of links for paginated results. Must be used within paginate tags.

    Usage:
    {% paginate results by 2 %}
      {% render 'pagination', paginate: paginate, anchor: '#yourID' %}
    {% endpaginate %}

    Accepts:
    - paginate: {Object}
    - anchor: {String} (optional) This can be added so that on page reload it takes you to wherever you've placed your anchor tag.
    - class: {String} (optional) Appended to container element's class attribute
{% endcomment %}

{%- if paginate.parts.size > 0 -%}
<nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
  {%- if paginate.previous -%}
    <a href="{{ paginate.previous.url }}" class="pagination__item" aria-label="Anterior">
      <i class='inline-block w-[30px] rotate-90'>{% render 'icon--caret' %}</i>
    </a>
  {%- else -%}
    <span class="inline-block w-[30px] rotate-90 text-black/30 cursor-not-allowed">{% render 'icon--caret' %}</span>
  {%- endif -%}

  {%- for part in paginate.parts -%}
    {%- if part.is_link -%}
      <a href="{{ part.url }}" class="pagination__item link px-md text-20 text-black/30 tabletp:hover:text-black">{{ part.title }}</a>
    {%- else -%}
      <span class="pagination__item pagination__item--current inline-block px-md">{{ part.title }}</span>
    {%- endif -%}
  {%- endfor -%}

  {%- if paginate.next -%}
    <a href="{{ paginate.next.url }}" class="pagination__item" aria-label="Siguiente">
      <i class='inline-block w-[30px] -rotate-90'>{% render 'icon--caret' %}</i>
    </a>
  {%- else -%}
    <span class="inline-block w-[30px] -rotate-90 text-black/30 cursor-not-allowed">{% render 'icon--caret' %}</span>
  {%- endif -%}
</nav>
{%- endif -%}
