    "section_image_text_blocks_AGAr6n": {
      "type": "section__image_text_blocks",
      "blocks": {
        "image_block_GVLkJK": {
          "type": "image_block",
          "settings": {
            "image": "shopify://shop_images/The_Path_-_Knowledge.jpg",
