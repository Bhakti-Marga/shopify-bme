          "settings": {
            "image": "shopify://shop_images/icon-placeholder.png",
            "title": "Harness the Power of Breath",
            "title_tag": "h3",
            "title_font_style": "h5",
            "description": "<p>The most powerful tool for meditation is always with us - our breath! Learn how to<strong>utilize the breath to take you into a calm, relaxed statewithin minutes.</strong></p>"
          }
        },
        "content_block_g4G4Lh": {
          "type": "content_block",
          "settings": {
