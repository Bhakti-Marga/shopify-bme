    "section_icon_grid_BFYa8i": {
      "type": "section__icon-grid",
      "blocks": {
        "content_block_VGaw7Y": {
          "type": "content_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/A_Hosted_Experience.png",
            "title": "A Hosted Experience",
            "title_tag": "h3",
            "title_font_style": "h5",
            "description": "<p>Each Sunday, our hosts will welcome you and guide you through the program. Often they will share updates on the latest happenings within the Bhakti Marga world or they may even conduct unique interviews with special guests, showing a little of the world of Bhakti Marga behind the scenes!<\/p>",
            "content_align": "items-start"
