{% liquid
  assign container_classes = ""
  if section.settings.padding_top != "pt-0"
    assign container_classes = container_classes | append: " " | append: section.settings.padding_top
  endif
  if section.settings.padding_bottom != "pb-0"
    assign container_classes = container_classes | append: " " | append: section.settings.padding_bottom
  endif
  if section.settings.desktop_padding_top != "inherit"
    assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_top
  endif
  if section.settings.desktop_padding_bottom != "inherit"
    assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_bottom
  endif
  assign container_classes = container_classes | strip
%}

<div class="BM-templos-divider" aria-hidden="true"></div>

<section class="BM-templos-grid container{% if container_classes != blank %} {{ container_classes }}{% endif %}">
  <ul class="BM-templos-grid__list">
    {% for block in section.blocks %}
      <li class="BM-templos-grid__card" {{ block.shopify_attributes }}>
        <div class="BM-templos-grid__media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'BM-templos-grid__img', alt: block.settings.title }}
          {% elsif block.settings.image_url != blank %}
            <img src="{{ block.settings.image_url | escape }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="BM-templos-grid__img">
          {% endif %}
        </div>
        {% if block.settings.location != blank %}
          <span class="BM-templos-grid__loc">{{ block.settings.location }}</span>
        {% endif %}
        {% if block.settings.title != blank %}
          <h3 class="BM-templos-grid__title">{{ block.settings.title }}</h3>
        {% endif %}
        {% if block.settings.description != blank %}
          <p class="BM-templos-grid__desc">{{ block.settings.description }}</p>
        {% endif %}
        {% if block.settings.cta_label != blank and block.settings.cta_url != blank %}
          <a class="BM-templos-grid__cta btn btn--gold" href="{{ block.settings.cta_url }}">{{ block.settings.cta_label }}</a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</section>

<style>
  .BM-templos-divider {
    position: relative;
    height: 80px;
    background: #16254c;
  }
  .BM-templos-divider::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 80px;
    background: #fff;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }
  .BM-templos-grid__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: 84rem;
    margin-left: auto;
    margin-right: auto;
  }
  @media (min-width: 64rem) {
    .BM-templos-grid__list {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
  .BM-templos-grid__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .BM-templos-grid__media {
    position: relative;
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 4 / 5;
    border-radius: 9999px 9999px 1.5rem 1.5rem;
    overflow: hidden;
    box-shadow: 0 1.5rem 3rem -1rem rgba(22, 37, 76, .25);
  }
  .BM-templos-grid__media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(214, 191, 144, .45);
    box-shadow: inset 0 0 0 8px rgba(255, 255, 255, .85), inset 0 0 0 9px rgba(214, 191, 144, .55);
    pointer-events: none;
    z-index: 1;
  }
  .BM-templos-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .BM-templos-grid__loc {
    margin-top: 2rem;
    font-size: .75rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: #d6bf90;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
  }
  .BM-templos-grid__loc::before,
  .BM-templos-grid__loc::after {
    content: "";
    width: 1.25rem;
    height: 1px;
    background: #d6bf90;
    opacity: .6;
    flex-shrink: 0;
  }
  .BM-templos-grid__title {
    margin-top: .75rem;
    font-weight: 600;
    font-size: 2rem;
    line-height: 1.1;
    letter-spacing: -.005em;
    color: #16254c;
  }
  @media (min-width: 64rem) {
    .BM-templos-grid__title {
      font-size: 2.5rem;
    }
  }
  .BM-templos-grid__desc {
    margin-top: 1rem;
    color: rgba(0, 0, 0, .7);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 38ch;
  }
  .BM-templos-grid__cta {
    margin-top: 1.75rem !important;
  }
</style>

{% schema %}
{
  "name": "Templos Grid",
  "settings": [
    {
      "type": "select",
      "id": "padding_top",
      "label": "Padding Top",
      "options": [
        { "value": "pt-0", "label": "None" },
        { "value": "pt-xl", "label": "X-Large - 40px" },
        { "value": "pt-xxl", "label": "XX-Large - 60px" },
        { "value": "pt-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "pt-xl"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "options": [
        { "value": "pb-0", "label": "None" },
        { "value": "pb-xl", "label": "X-Large - 40px" },
        { "value": "pb-xxl", "label": "XX-Large - 60px" },
        { "value": "pb-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "pb-xxl"
    },
    {
      "type": "select",
      "id": "desktop_padding_top",
      "label": "Desktop - Padding Top",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "tabletl:pt-xl", "label": "X-Large - 40px" },
        { "value": "tabletl:pt-xxl", "label": "XX-Large - 60px" },
        { "value": "tabletl:pt-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "tabletl:pt-xxxl"
    },
    {
      "type": "select",
      "id": "desktop_padding_bottom",
      "label": "Desktop - Padding Bottom",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "tabletl:pb-xl", "label": "X-Large - 40px" },
        { "value": "tabletl:pb-xxl", "label": "XX-Large - 60px" },
        { "value": "tabletl:pb-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "tabletl:pb-xxxl"
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Templo Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (from media library)"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL (direct CDN link, used if no image above)"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Templos Grid"
    }
  ]
}
{% endschema %}
