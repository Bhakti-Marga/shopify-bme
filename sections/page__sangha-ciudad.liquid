{% liquid
  assign city = section.settings.city_name | default: 'Nuestra Ciudad'
  assign whatsapp_url = section.settings.whatsapp_community_url | default: '#'
  assign contact_email = section.settings.contact_email | default: '#'
%}

<style>
  .sc-root {
    --sc-navy: #16254c;
    --sc-gold: #D6BF90;
    --sc-gold-light: #e8dcc0;
    --sc-white: #fafaf8;
    --sc-cream: #f4f0e8;
    --sc-text: #1a1a18;
    --sc-muted: #6b6b67;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* ── HERO ─────────────────────────────────── */
  .sc-hero {
    background-color: var(--sc-navy);
    color: #fff;
    padding: 80px 20px 60px;
    position: relative;
    overflow: hidden;
  }
  .sc-hero__bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    opacity: 0.25;
  }
  .sc-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, var(--sc-navy) 0%, rgba(22,37,76,.45) 60%, rgba(22,37,76,.2) 100%);
  }
  .sc-hero__inner {
    position: relative; max-width: 1200px; margin: 0 auto;
  }
  .sc-eyebrow {
    font-size: 11px; letter-spacing: .2em; text-transform: uppercase;
    font-weight: 600; margin-bottom: 14px;
  }
  .sc-hero__title {
    font-size: clamp(2.4rem, 6vw, 5rem);
    font-weight: 600; line-height: 1.05; margin-bottom: 18px;
    letter-spacing: -.01em;
  }
  .sc-hero__sub {
    font-size: 17px; line-height: 1.75; color: rgba(255,255,255,.8);
    max-width: 560px; margin-bottom: 28px;
  }
  .sc-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }

  /* ── WELCOME ──────────────────────────────── */
  .sc-welcome {
    padding: 72px 20px;
    background: var(--sc-white);
  }
  .sc-welcome__inner {
    max-width: 1200px; margin: 0 auto;
  }
  .sc-welcome__lead {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 600; color: var(--sc-navy);
    margin-bottom: 16px; line-height: 1.4; max-width: 780px;
  }
  .sc-welcome__lead em { font-style: italic; font-weight: 400; }
  .sc-welcome__body {
    font-size: 16px; line-height: 1.85; color: var(--sc-muted);
    max-width: 720px; margin-bottom: 0;
  }
  .sc-section-title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 600; color: var(--sc-navy);
    margin-bottom: 8px; line-height: 1.15;
  }
  .sc-section-body {
    font-size: 16px; line-height: 1.85; color: var(--sc-muted); margin-bottom: 0;
  }

  /* ── PHOTO GRID ───────────────────────────── */
  .sc-photos { padding: 0 20px 64px; }
  .sc-photos__inner { max-width: 1200px; margin: 0 auto; }
  .sc-photos__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 220px;
    gap: 8px; border-radius: 16px; overflow: hidden;
  }
  .sc-photos__item {
    overflow: hidden; background: rgba(22,37,76,.12);
  }
  .sc-photos__item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sc-photos__item--placeholder {
    display: flex; align-items: center; justify-content: center;
    background: rgba(22,37,76,.08);
    font-family: monospace; font-size: 10px;
    color: rgba(22,37,76,.3); text-align: center; line-height: 1.6;
  }
  @media (max-width: 640px) {
    .sc-photos__grid { grid-template-columns: 1fr 1fr; grid-auto-rows: 150px; }
  }

  /* ── EVENTS ───────────────────────────────── */
  .sc-events { padding: 72px 20px; background: var(--sc-cream); }
  .sc-events__inner { max-width: 1200px; margin: 0 auto; }
  .sc-events__header {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 20px; flex-wrap: wrap; margin-bottom: 32px;
  }
  .sc-location-tabs { display: flex; gap: 8px; flex-wrap: wrap; }
  .sc-tab {
    padding: 7px 18px; border-radius: 999px; font-size: 12px; font-weight: 500;
    letter-spacing: .06em; cursor: pointer; border: 1.5px solid transparent;
    transition: all .18s; background: #fff; color: var(--sc-muted);
  }
  .sc-tab--active { background: var(--sc-navy); color: #fff; }
  .sc-tab:hover:not(.sc-tab--active) { border-color: var(--sc-navy); color: var(--sc-navy); }
  .sc-events__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) { .sc-events__grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 560px) { .sc-events__grid { grid-template-columns: 1fr; } }

  .sc-event-card {
    background: #fff; border-radius: 14px; overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform .2s, box-shadow .2s;
  }
  .sc-event-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(22,37,76,.1); }
  .sc-event-card__img {
    aspect-ratio: 16/9; overflow: hidden;
    background: rgba(22,37,76,.08);
    display: flex; align-items: center; justify-content: center;
  }
  .sc-event-card__img img { width:100%; height:100%; object-fit:cover; display:block; }
  .sc-event-card__img-placeholder {
    font-family: monospace; font-size: 9px;
    color: rgba(22,37,76,.25); text-align: center; line-height: 1.6;
  }
  .sc-event-card__body { padding: 18px; flex: 1; display: flex; flex-direction: column; }
  .sc-event-card__meta {
    display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;
  }
  .sc-badge {
    display: inline-block; padding: 3px 10px; border-radius: 999px;
    font-size: 10px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
  }
  .sc-badge--meditacion { background: #e6f4ea; color: #1e6e38; }
  .sc-badge--satsang    { background: #fef3e2; color: #8f5c0c; }
  .sc-badge--kirtan     { background: #fde8f0; color: #87184a; }
  .sc-badge--ceremonia  { background: #e8edf8; color: #1a3870; }
  .sc-badge--yoga       { background: #f0e8f8; color: #581d8a; }
  .sc-badge--bhakti     { background: #f8ece8; color: #8a2b1d; }
  .sc-badge--default    { background: rgba(22,37,76,.08); color: var(--sc-navy); }
  .sc-event-card__date { font-size: 12px; color: var(--sc-muted); }
  .sc-event-card__title {
    font-size: 1.15rem; font-weight: 600; color: var(--sc-navy);
    margin-bottom: 6px; line-height: 1.3;
  }
  .sc-event-card__loc {
    font-size: 12px; color: var(--sc-muted); margin-bottom: 14px;
  }
  .sc-event-card__actions {
    margin-top: auto; display: flex; gap: 8px; flex-wrap: wrap;
  }

  /* ── BUTTONS ──────────────────────────────── */
  .sc-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: .7rem 1.6rem; border-radius: 999px;
    font-size: 13px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase;
    text-decoration: none; cursor: pointer; transition: opacity .18s, transform .15s;
    border: none; line-height: 1;
  }
  .sc-btn:hover { opacity: .82; transform: translateY(-1px); }
  .sc-btn--sm { padding: .5rem 1.1rem; font-size: 11px; }
  .sc-btn--gold { background: var(--sc-gold); color: var(--sc-navy); }
  .sc-btn--navy { background: var(--sc-navy); color: #fff; }
  .sc-btn--white { background: #fff; color: var(--sc-navy); }
  .sc-btn--outline { background: transparent; color: var(--sc-navy); border: 1.5px solid var(--sc-navy); }
  .sc-btn--outline-white { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,.55); }
  .sc-btn--whatsapp { background: #25D366; color: #fff; }
  .sc-btn--email { background: #1a1a18; color: #fff; }

  /* ── INFO CARDS (OM / AKY) ────────────────── */
  .sc-info { padding: 72px 20px; background: var(--sc-white); }
  .sc-info__inner { max-width: 1200px; margin: 0 auto; }
  .sc-info__header { margin-bottom: 36px; }
  .sc-info__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
  @media (max-width: 860px) { .sc-info__grid { grid-template-columns: 1fr; } }
  .sc-info-card {
    background: var(--sc-cream); border-radius: 16px; padding: 32px 28px;
    transition: transform .2s;
  }
  .sc-info-card:hover { transform: translateY(-3px); }
  .sc-info-card__icon { font-size: 1.8rem; margin-bottom: 14px; }
  .sc-info-card__title {
    font-size: 1.1rem; font-weight: 600; color: var(--sc-navy);
    margin-bottom: 10px; line-height: 1.3;
  }
  .sc-info-card__body { font-size: 14px; line-height: 1.75; color: var(--sc-muted); }

  /* ── COUNTDOWN ────────────────────────────── */
  .sc-countdown {
    background: var(--sc-navy); color: #fff;
    padding: 72px 20px; text-align: center;
  }
  .sc-countdown__inner { max-width: 800px; margin: 0 auto; }
  .sc-countdown__timer {
    display: flex; justify-content: center; gap: 32px;
    margin: 40px 0; flex-wrap: wrap;
  }
  .sc-countdown__unit { text-align: center; }
  .sc-countdown__num {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700; line-height: 1; color: var(--sc-gold);
    display: block;
  }
  .sc-countdown__label {
    font-size: 10px; letter-spacing: .18em; text-transform: uppercase;
    color: rgba(255,255,255,.5); margin-top: 6px;
  }

  /* ── MONKS ────────────────────────────────── */
  .sc-monks { padding: 72px 20px; background: var(--sc-cream); }
  .sc-monks__inner { max-width: 1200px; margin: 0 auto; }
  .sc-monks__grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 48px; margin-top: 40px; }
  @media (max-width: 720px) { .sc-monks__grid { grid-template-columns: 1fr; gap: 32px; } }
  .sc-monk {
    display: grid; grid-template-columns: 110px 1fr; gap: 24px; align-items: start;
  }
  @media (max-width: 400px) { .sc-monk { grid-template-columns: 1fr; } }
  .sc-monk__photo {
    width: 110px; height: 110px; border-radius: 50%; overflow: hidden;
    background: rgba(22,37,76,.1); flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .sc-monk__photo img { width:100%; height:100%; object-fit:cover; }
  .sc-monk__photo-placeholder {
    font-family: monospace; font-size: 9px;
    color: rgba(22,37,76,.3); text-align: center; line-height: 1.6;
  }
  .sc-monk__role {
    font-size: 10px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--sc-gold); font-weight: 600; margin-bottom: 4px;
  }
  .sc-monk__name {
    font-size: 1.35rem; font-weight: 600; color: var(--sc-navy);
    margin-bottom: 10px; line-height: 1.2;
  }
  .sc-monk__bio { font-size: 14px; line-height: 1.75; color: var(--sc-muted); margin-bottom: 12px; }
  .sc-monk__links { display: flex; gap: 12px; flex-wrap: wrap; }
  .sc-monk__link {
    font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
    color: var(--sc-navy); text-decoration: none; font-weight: 600;
    display: flex; align-items: center; gap: 4px;
    border-bottom: 1px solid rgba(22,37,76,.25); padding-bottom: 1px;
    transition: border-color .15s;
  }
  .sc-monk__link:hover { border-color: var(--sc-navy); }

  /* ── CONTACT ──────────────────────────────── */
  .sc-contact { padding: 72px 20px; background: var(--sc-white); }
  .sc-contact__inner { max-width: 680px; margin: 0 auto; text-align: center; }
  .sc-contact__form {
    background: var(--sc-cream); border-radius: 20px;
    padding: 40px 36px; margin-top: 32px; text-align: left;
  }
  @media (max-width: 560px) { .sc-contact__form { padding: 28px 20px; } }
  .sc-contact__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 560px) { .sc-contact__row { grid-template-columns: 1fr; } }
  .sc-field { margin-bottom: 16px; }
  .sc-label {
    display: block; font-size: 11px; letter-spacing: .1em;
    text-transform: uppercase; color: var(--sc-muted); font-weight: 500; margin-bottom: 6px;
  }
  .sc-input {
    width: 100%; padding: .75rem 1rem; border-radius: 10px;
    border: 1.5px solid rgba(22,37,76,.15); font-size: 15px;
    font-family: inherit; color: var(--sc-text); background: #fff;
    transition: border-color .18s;
  }
  .sc-input:focus { outline: none; border-color: var(--sc-navy); }
  textarea.sc-input { resize: vertical; min-height: 100px; }
  .sc-contact__note {
    font-size: 12px; color: var(--sc-muted); text-align: center; margin-top: 12px; line-height: 1.6;
  }

  /* ── FLOATING CTAs ────────────────────────── */
  .sc-floating {
    position: fixed; right: 20px; bottom: 24px;
    display: flex; flex-direction: column; gap: 10px; z-index: 999;
  }
  .sc-floating__btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 18px; border-radius: 999px;
    font-size: 13px; font-weight: 600; color: #fff;
    text-decoration: none; box-shadow: 0 8px 24px rgba(0,0,0,.18);
    transition: transform .2s, box-shadow .2s;
  }
  .sc-floating__btn:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgba(0,0,0,.22); }
  .sc-floating__btn--wa { background: #25D366; }
  .sc-floating__btn--email { background: var(--sc-navy); }

  /* ── DIVIDER ──────────────────────────────── */
  .sc-divider {
    max-width: 1200px; margin: 0 auto 0; padding: 0 20px;
    border: none; border-top: 1px solid rgba(22,37,76,.1);
  }

  /* ── JOIN CTA STRIP ───────────────────────── */
  .sc-join-strip {
    background: var(--sc-gold); padding: 20px; text-align: center;
  }
  .sc-join-strip p {
    font-size: 15px; color: var(--sc-navy); font-weight: 500; margin-bottom: 12px;
  }
</style>

<div class="sc-root">

  {%- comment -%}════════════════ HERO ════════════════{%- endcomment -%}
  <section class="sc-hero">
    {% if section.settings.hero_image != blank %}
      <div class="sc-hero__bg" style="background-image: url('{{ section.settings.hero_image | image_url: width: 1600 }}');"></div>
    {% endif %}
    <div class="sc-hero__overlay"></div>
    <div class="sc-hero__inner">
      <p class="sc-eyebrow" style="color: var(--sc-gold);">Bhakti Marga · Comunidad</p>
      <h1 class="sc-hero__title">Comunidad {{ city }}</h1>
      <p class="sc-hero__sub">{{ section.settings.hero_subtitle }}</p>
      <div class="sc-hero__ctas">
        <a href="#sc-eventos" class="sc-btn sc-btn--gold">{{ section.settings.hero_cta_label | default: 'Encontrar una Reunión Cerca de Mí' }}</a>
        <a href="#sc-contacto" class="sc-btn sc-btn--outline-white">{{ section.settings.hero_cta2_label | default: 'Contáctanos' }}</a>
      </div>
    </div>
  </section>

  {%- comment -%}════════════════ WELCOME ════════════════{%- endcomment -%}
  <section class="sc-welcome">
    <div class="sc-welcome__inner">
      <p class="sc-welcome__lead">
        <strong>{{ section.settings.welcome_headline | default: 'No importa en qué punto de tu camino espiritual estés,' }}</strong>
        <em> {{ section.settings.welcome_subheadline | default: 'eres bienvenido aquí.' }}</em>
      </p>
      <div class="sc-welcome__body">{{ section.settings.welcome_body }}</div>
    </div>
  </section>

  {%- comment -%}════════════════ PHOTO GRID ════════════════{%- endcomment -%}
  {%- assign photo_blocks = section.blocks | where: 'type', 'photo' -%}
  {% if photo_blocks.size > 0 %}
    <div class="sc-photos">
      <div class="sc-photos__inner">
        <div class="sc-photos__grid">
          {% for block in photo_blocks %}
            <div class="sc-photos__item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {% render 'lazy-image',
                  image: block.settings.image,
                  img_classes: 'w-full h-full object-cover'
                %}
              {% else %}
                <div class="sc-photos__item--placeholder">foto<br>comunidad</div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  {%- comment -%}════════════════ EVENTS ════════════════{%- endcomment -%}
  {%- assign event_blocks = section.blocks | where: 'type', 'event' -%}
  {%- assign location_blocks = section.blocks | where: 'type', 'location' -%}
  <section class="sc-events" id="sc-eventos">
    <div class="sc-events__inner">
      <div class="sc-events__header">
        <div>
          <p class="sc-eyebrow" style="color:var(--sc-gold);">{{ section.settings.events_eyebrow | default: 'Próximas Reuniones' }}</p>
          <h2 class="sc-section-title">{{ section.settings.events_title | default: 'Encuentra Reuniones Cerca de Ti' }}</h2>
          {% if section.settings.events_subtitle != blank %}
            <p class="sc-section-body" style="margin-top:6px;max-width:560px;">{{ section.settings.events_subtitle }}</p>
          {% endif %}
        </div>
        {% if location_blocks.size > 0 %}
          <div class="sc-location-tabs">
            <button class="sc-tab sc-tab--active" onclick="scFilterEvents(this,'all')">
              {{ section.settings.tab_all_label | default: 'Ver Todas las Ubicaciones' }}
            </button>
            {% for block in location_blocks %}
              <button class="sc-tab" onclick="scFilterEvents(this,'{{ block.settings.location_key }}')" {{ block.shopify_attributes }}>
                {{ block.settings.location_name }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="sc-events__grid" id="sc-events-grid">
        {% for block in event_blocks %}
          {%- assign badge_class = 'sc-badge--default' -%}
          {%- assign cat_lower = block.settings.category | downcase -%}
          {%- if cat_lower contains 'medit' -%}{%- assign badge_class = 'sc-badge--meditacion' -%}
          {%- elsif cat_lower contains 'satsang' -%}{%- assign badge_class = 'sc-badge--satsang' -%}
          {%- elsif cat_lower contains 'kirtan' -%}{%- assign badge_class = 'sc-badge--kirtan' -%}
          {%- elsif cat_lower contains 'ceremon' or cat_lower contains 'yajna' or cat_lower contains 'puja' -%}{%- assign badge_class = 'sc-badge--ceremonia' -%}
          {%- elsif cat_lower contains 'yoga' or cat_lower contains 'kriya' -%}{%- assign badge_class = 'sc-badge--yoga' -%}
          {%- elsif cat_lower contains 'bhakti' or cat_lower contains 'noche' -%}{%- assign badge_class = 'sc-badge--bhakti' -%}
          {%- endif -%}
          <div class="sc-event-card" data-location="{{ block.settings.location_key }}" {{ block.shopify_attributes }}>
            <div class="sc-event-card__img">
              {% if block.settings.image != blank %}
                {% render 'lazy-image', image: block.settings.image, img_classes: 'w-full h-full object-cover' %}
              {% else %}
                <div class="sc-event-card__img-placeholder">imagen<br>evento</div>
              {% endif %}
            </div>
            <div class="sc-event-card__body">
              <div class="sc-event-card__meta">
                {% if block.settings.category != blank %}
                  <span class="sc-badge {{ badge_class }}">{{ block.settings.category }}</span>
                {% endif %}
                {% if block.settings.date != blank %}
                  <span class="sc-event-card__date">{{ block.settings.date }}</span>
                {% endif %}
              </div>
              <h3 class="sc-event-card__title">{{ block.settings.title }}</h3>
              {% if block.settings.location != blank %}
                <p class="sc-event-card__loc">📍 {{ block.settings.location }}</p>
              {% endif %}
              <div class="sc-event-card__actions">
                {% if block.settings.cta1_label != blank %}
                  {%- assign cta1_style = 'sc-btn--gold' -%}
                  {%- if block.settings.cta1_style == 'whatsapp' -%}{%- assign cta1_style = 'sc-btn--whatsapp' -%}{%- endif -%}
                  {%- if block.settings.cta1_style == 'email' -%}{%- assign cta1_style = 'sc-btn--email' -%}{%- endif -%}
                  {%- if block.settings.cta1_style == 'outline' -%}{%- assign cta1_style = 'sc-btn--outline' -%}{%- endif -%}
                  <a href="{{ block.settings.cta1_url }}" class="sc-btn sc-btn--sm {{ cta1_style }}" target="_blank">{{ block.settings.cta1_label }}</a>
                {% endif %}
                {% if block.settings.cta2_label != blank %}
                  {%- assign cta2_style = 'sc-btn--outline' -%}
                  {%- if block.settings.cta2_style == 'whatsapp' -%}{%- assign cta2_style = 'sc-btn--whatsapp' -%}{%- endif -%}
                  {%- if block.settings.cta2_style == 'email' -%}{%- assign cta2_style = 'sc-btn--email' -%}{%- endif -%}
                  <a href="{{ block.settings.cta2_url }}" class="sc-btn sc-btn--sm {{ cta2_style }}" target="_blank">{{ block.settings.cta2_label }}</a>
                {% endif %}
                {% if block.settings.show_calendar %}
                  <a href="#" class="sc-btn sc-btn--sm sc-btn--outline" onclick="scAddToCalendar(event,'{{ block.settings.title | escape }}','{{ block.settings.date | escape }}','{{ block.settings.location | escape }}')">+ Calendario</a>
                {% endif %}
              </div>
            </div>
          </div>
        {% else %}
          <p style="color:var(--sc-muted);font-size:15px;grid-column:1/-1;">
            No hay eventos configurados aún. Añade bloques de tipo "Evento" desde el editor de Shopify.
          </p>
        {% endfor %}
      </div>

      {% if whatsapp_url != '#' %}
        <div style="text-align:center;margin-top:40px;">
          <a href="{{ whatsapp_url }}" class="sc-btn sc-btn--whatsapp" target="_blank">
