<script>
  // ── Location filter ──────────────────────────
  function scFilterEvents(btn, location) {
    document.querySelectorAll('.sc-tab').forEach(b => b.classList.remove('sc-tab--active'));
    btn.classList.add('sc-tab--active');
    document.querySelectorAll('.sc-event-card').forEach(card => {
      const show = location === 'all' || !card.dataset.location || card.dataset.location === location;
      card.style.display = show ? 'flex' : 'none';
    });
  }

  // ── Countdown timer ──────────────────────────
  (function() {
    var targetDate = '{{ section.settings.countdown_date }}';
    if (!targetDate) return;
    var target = new Date(targetDate).getTime();
    function tick() {
      var now = Date.now();
      var diff = target - now;
      if (diff <= 0) diff = 0;
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      function pad(n) { return String(n).padStart(2,'0'); }
      var dEl = document.getElementById('sc-days');
      var hEl = document.getElementById('sc-hours');
      var mEl = document.getElementById('sc-mins');
      var sEl = document.getElementById('sc-secs');
      if (dEl) dEl.textContent = pad(d);
      if (hEl) hEl.textContent = pad(h);
      if (mEl) mEl.textContent = pad(m);
      if (sEl) sEl.textContent = pad(s);
    }
    tick();
    setInterval(tick, 1000);
  })();

  // ── Add to Calendar (basic .ics) ─────────────
  function scAddToCalendar(e, title, dateStr, location) {
    e.preventDefault();
    var now = new Date().toISOString().replace(/[-:]/g,'').split('.')[0]+'Z';
    var ics = [
      'BEGIN:VCALENDAR','VERSION:2.0','BEGIN:VEVENT',
      'SUMMARY:' + title,
      'DTSTART:' + now,
      'LOCATION:' + location,
      'END:VEVENT','END:VCALENDAR'
    ].join('\r\n');
    var blob = new Blob([ics], {type:'text/calendar'});
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'event.ics';
    a.click();
  }
</script>

