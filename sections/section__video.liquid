{% capture modal_id %}VideoModal-{{ section.id }}{% endcapture %}
{% capture modal_open_selector %}js-open-modal-{{ section.id }}{% endcapture %}
{% capture modal_close_selector %}js-close-modal-{{ section.id }}{% endcapture %}

{% liquid
  assign container_classes = ""

  if section.settings.margin_top != "mt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.margin_top
  endif

  if section.settings.margin_bottom != "mb-0"
      assign container_classes = container_classes | append: " " | append: section.settings.margin_bottom
  endif

  if section.settings.desktop_margin_top != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_top
  endif

  if section.settings.desktop_margin_bottom != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_bottom
  endif

  if section.settings.padding_top != "pt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_top
  endif

  if section.settings.padding_bottom != "pb-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_bottom
  endif

  if section.settings.desktop_padding_top != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_top
  endif

  if section.settings.desktop_padding_bottom != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_bottom
  endif

  assign container_classes = container_classes | strip
%}

<section class="video container {% if container_classes != blank %} {{ container_classes }}{% endif %} {% if section.settings.set_100vh %} screen-height {% endif %}">
  {% if section.settings.video_url != blank %}
    <div class="video__poster-container relative overflow-hidden rounded {% if section.settings.set_100vh %} h-full {% endif %}"
      style="{% unless section.settings.set_100vh %} --aspect-ratio: {{ section.settings.aspect_ratio }}; --aspect-ratio-desktop: {{ section.settings.aspect_ratio_desktop }};{% endunless %}">
      <div class="video__poster relative h-full">
        {% if section.settings.poster_video != blank or section.settings.poster_video_desktop != blank %}
          {% assign video_class = 'w-full h-full object-cover block' %}
          
          {% if section.settings.poster_video != blank %}
            {% if section.settings.poster_video_desktop != blank %}
              {% assign video_class = video_class | append: ' tabletl:hidden' %}
            {% endif %}
            {{ section.settings.poster_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1024x', class: video_class }}
          {% endif %}
          {% if section.settings.poster_video_desktop  != blank %}
            {% if section.settings.poster_video != blank %}
              {% assign video_class = video_class | append: 'hidden tabletl:block' %}
            {% endif %}
            {{ section.settings.poster_video_desktop | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1024x', class: video_class }}
          {% endif %}   
        {% elsif section.settings.poster_image != blank %}
          {% render 'lazy-image',
            image: section.settings.poster_image,
            image_desktop: section.settings.poster_image_desktop,
            img_classes: 'object-cover absolute top-0 left-0 h-full'
          %}
        {% endif %}
        <div class="p-lg absolute inset-0 flex items-center justify-center">
          <button
            class="video-modal-trigger btn flex items-center gap-12 bg-opacity-30 text-white py-md px-32 hover:bg-opacity-50 backdrop-blur-[2px]"
            aria-label="Play video"
            {{ modal_open_selector }}
          >
            <span class="video-modal-trigger__icon w-12 h-12 flex items-center justify-center relative -top-[1px]">
              {% render 'icon--play' %}
            </span>
            <span class="video-modal-trigger__text">
              Ver
            </span>
          </button>
        </div>    
      </div>
    </div>
  {% endif %}

  {% render 'video-modal',
    modal_id: modal_id,
    video_url: section.settings.video_url,
    selectors_open: modal_open_selector,
    selectors_close: modal_close_selector
  %}
</section>

