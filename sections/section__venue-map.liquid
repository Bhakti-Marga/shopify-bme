{%- liquid
  assign container_classes = "container"

  if section.settings.margin_top != "mt-0"
    assign container_classes = container_classes | append: " " | append: section.settings.margin_top
  endif

  if section.settings.margin_bottom != "mb-0"
    assign container_classes = container_classes | append: " " | append: section.settings.margin_bottom
  endif

  if section.settings.desktop_margin_top != "inherit"
    assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_top
  endif

  if section.settings.desktop_margin_bottom != "inherit"
    assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_bottom
  endif

  assign container_classes = container_classes | strip
-%}

<section class="{{ container_classes }}">
  <div class="grid grid-cols-1 tabletl:grid-cols-2 tabletl:gap-md">

    <div class="relative w-full overflow-hidden rounded tabletl:order-last" style="min-height: 400px;">
      {% if section.settings.map_embed_url != blank %}
        <iframe
          src="{{ section.settings.map_embed_url }}"
          width="100%"
          height="100%"
          style="border: 0; position: absolute; inset: 0; width: 100%; height: 100%;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="{{ section.settings.title | escape }}"
        ></iframe>
      {% endif %}
    </div>

    <div class="tabletl:px-md h-full flex flex-col tabletl:justify-center py-lg tabletl:py-xxl">
      <div class="flex flex-col gap-md tabletl:max-w-[490px] tabletl:mx-auto tabletl:w-full">
        {% if section.settings.eyebrow != blank %}
          <p class="text-12 font-600 uppercase tracking-widest text-gray-light">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.title != blank %}
          <h2 class="{{ section.settings.title_font_style }}">{{ section.settings.title }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="rte">{{ section.settings.description }}</div>
        {% endif %}

        {% if section.settings.cta_url != blank and section.settings.cta_label != blank %}
          <div class="flex gap-sm flex-wrap">
            <a href="{{ section.settings.cta_url }}" class="btn btn--gold inline-block text-center" style="min-width: 14rem">
              {{ section.settings.cta_label }}
            </a>
            {% if section.settings.cta_2_url != blank and section.settings.cta_2_label != blank %}
              <a href="{{ section.settings.cta_2_url }}" class="btn btn--gold inline-block text-center" style="min-width: 14rem">
                {{ section.settings.cta_2_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Venue + Mapa",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "margin_top",
      "label": "Margin Top",
      "options": [
        { "value": "mt-0", "label": "None" },
        { "value": "mt-sm", "label": "Small" },
        { "value": "mt-md", "label": "Medium" },
        { "value": "mt-lg", "label": "Large" },
        { "value": "mt-xl", "label": "X-Large" },
        { "value": "mt-xxl", "label": "XX-Large" },
        { "value": "mt-xxxl", "label": "XXX-Large" }
      ],
      "default": "mt-0"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "options": [
        { "value": "mb-0", "label": "None" },
        { "value": "mb-sm", "label": "Small" },
        { "value": "mb-md", "label": "Medium" },
        { "value": "mb-lg", "label": "Large" },
        { "value": "mb-xl", "label": "X-Large" },
        { "value": "mb-xxl", "label": "XX-Large" },
        { "value": "mb-xxxl", "label": "XXX-Large" }
      ],
      "default": "mb-0"
    },
    {
      "type": "select",
      "id": "desktop_margin_top",
      "label": "Desktop - Margin Top",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "tabletl:mt-0", "label": "None" },
        { "value": "tabletl:mt-xl", "label": "X-Large" },
        { "value": "tabletl:mt-xxl", "label": "XX-Large" },
        { "value": "tabletl:mt-xxxl", "label": "XXX-Large" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "desktop_margin_bottom",
      "label": "Desktop - Margin Bottom",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "tabletl:mb-0", "label": "None" },
        { "value": "tabletl:mb-xl", "label": "X-Large" },
        { "value": "tabletl:mb-xxl", "label": "XX-Large" },
        { "value": "tabletl:mb-xxxl", "label": "XXX-Large" }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "Mapa"
    },
    {
      "type": "text",
      "id": "map_embed_url",
      "label": "URL de incrustación de Google Maps",
      "info": "Abre Google Maps → Compartir → Incorporar un mapa → copia la URL del atributo src del iframe.",
      "default": "https://maps.google.com/maps?q=Hotel+Beatriz+Costa+y+Spa,+Calle+Atalaya+3,+35509+Costa+Teguise,+Lanzarote&output=embed&hl=es"
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto sobre el título (eyebrow)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "title_font_style",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción"
    },
    {
      "type": "header",
      "content": "Botones"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Botón principal — Texto"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Botón principal — Enlace"
    },
    {
      "type": "text",
      "id": "cta_2_label",
      "label": "Botón secundario — Texto"
    },
    {
      "type": "url",
      "id": "cta_2_url",
      "label": "Botón secundario — Enlace"
    }
  ],
  "presets": [
    {
      "name": "Venue + Mapa"
    }
  ]
}
{% endschema %}
