{% liquid
  assign container_classes = ""

  if section.settings.padding_top != "pt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_top
  endif

  if section.settings.padding_bottom != "pb-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_bottom
  endif

  if section.settings.desktop_padding_top != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_top
  endif

  if section.settings.desktop_padding_bottom != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_bottom
  endif

  assign container_classes = container_classes | strip
%}

{%- capture carousel_options -%}
  {
    "slidesPerView": "auto",
    "freeMode": true,
    "touchRatio": 1,
    "momentum": true,
    "mousewheel": {
      "forceToAxis": true
    },
    "simulateTouch": true,
    "loop": false,
    "spaceBetween": "16",
    "watchOverflow": true,
    "cssMode": true,
    "navigation": {
      "enabled": true,
      "prevEl": "[js-button-prev-{{ section.id }}]",
      "nextEl": "[js-button-next-{{ section.id }}]"
    },
    "pagination": {
      "el": ".swiper-pagination",
      "type": "bullets",
      "clickable": true
    }
  }
{%- endcapture -%}

{% assign block_count = 0 %}
{%- for block in section.blocks -%}
  {% if block.settings.article.metafields.event.video.value != blank or block.settings.article.metafields.event.video_poster != blank %}
    {% assign block_count = block_count | plus: 1 %}
  {% endif %}
{%- endfor -%}

<div class="events-carousel {% if container_classes != blank %} {{ container_classes }}{% endif %} {% if section.settings.set_dark_theme %} bg-blue text-white {% else %} bg-white text-black light-theme {% endif %}">
  <s-carousel class="grid grid-cols-1" data-options='{{carousel_options}}' data-locked="true">
    <div class="events-carousel-header container w-full mb-lg tabletl:mb-xl">
      <div class="grid grid-cols-1 tabletl:grid-cols-3">
        <div class="flex flex-col tabletl:flex-row tabletl:col-span-2 tabletl:items-center">
          {% if section.settings.title != blank %}
            <{{ section.settings.title_tag }} class="events-carousel-header__title h5 mb-lg tabletl:mb-0">
                {{ section.settings.title }}
            </{{ section.settings.title_tag }}>
          {% endif %}
          {% if section.settings.cta_label != blank and section.settings.cta_url != blank %}
            <a
              class="events-carousel-header__cta group inline-flex items-center text-12 uppercase tabletl:ml-lg"
              href="{{ section.settings.cta_url }}"
            >{{ section.settings.cta_label }}<i class="inline-block ml-xs w-md h-md -rotate-90 duration-500 group-hover:translate-x-xs">{% render 'icon--caret' %}</i></a>
          {% endif %}
        </div>
        <div class="events-carousel__navigation{% if section.settings.hide_arrows_desktop == true %} hidden{% else %} hidden gap-sm justify-end items-center tabletl:flex{% endif %}">
          <button class="events-carousel__nav-button" js-button-prev-{{ section.id }}>
            <i class='inline-block w-lg rotate-90'>{% render 'icon--caret' %}</i>
          </button>
          <button class="events-carousel__nav-button" js-button-next-{{ section.id }}>
            <i class='inline-block w-lg -rotate-90'>{% render 'icon--caret' %}</i>
          </button>
        </div>
      </div>
    </div>
    <div
      id="{{ section.id }}--carousel"
      class="swiper swiper--left-offset w-full pb-[50px]"
      js-carousel
    >
      <div class="swiper-wrapper w-full">
        {% assign slide_index = 0 %}
        
        {%- for block in section.blocks -%}
          {% if block.settings.article.metafields.event.video.value != blank or block.settings.article.metafields.event.video_poster != blank %}
            {% assign slide_index = slide_index | plus: 1 %}
            <div class="swiper-slide block w-[80%] tabletp:w-[33.3333%] tabletl:w-[20%] box-content {% if slide_index == 1 %}tabletp:pl-20 tabletl:pl-xl{% elsif slide_index == block_count %}pl-0 pr-md tabletp:pr-20 tabletl:pr-xl{% endif %}" js-carousel-slide>
              {%- render 'event-card', article: block.settings.article, gradient: section.settings.apply_gradient -%}
            </div>
          {% endif %}
        {% endfor %}
      </div> 
      <div class="swiper-pagination"></div>
    </div>
  </s-carousel>
</div>

{% schema %}
{
  "name": "Events Carousel",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Padding Top",
      "options": [
        { "value": "pt-0", "label": "None" },
        { "value": "pt-sm", "label": "Small - 8px" },
        { "value": "pt-md", "label": "Medium - 16px" },
        { "value": "pt-lg", "label": "Large - 24px" },
        { "value": "pt-xl", "label": "X-Large - 40px" },
        { "value": "pt-xxl", "label": "XX-Large - 60px" },
        { "value": "pt-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "pt-xxxl"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "options": [
        { "value": "pb-0", "label": "None" },
        { "value": "pb-sm", "label": "Small - 8px" },
        { "value": "pb-md", "label": "Medium - 16px" },
        { "value": "pb-lg", "label": "Large - 24px" },
        { "value": "pb-xl", "label": "X-Large - 40px" },
        { "value": "pb-xxl", "label": "XX-Large - 60px" },
        { "value": "pb-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "pb-xxxl"
    },
    {
      "type": "select",
      "id": "desktop_padding_top",
      "label": "Desktop - Padding Top",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "tabletl:pt-0", "label": "None" },
        { "value": "tabletl:pt-sm", "label": "Small - 8px" },
        { "value": "tabletl:pt-md", "label": "Medium - 16px" },
        { "value": "tabletl:pt-lg", "label": "Large - 24px" },
        { "value": "tabletl:pt-xl", "label": "X-Large - 40px" },
        { "value": "tabletl:pt-xxl", "label": "XX-Large - 60px" },
        { "value": "tabletl:pt-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "desktop_padding_bottom",
      "label": "Desktop - Padding Bottom",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "tabletl:pb-0", "label": "None" },
        { "value": "tabletl:pb-sm", "label": "Small - 8px" },
        { "value": "tabletl:pb-md", "label": "Medium - 16px" },
        { "value": "tabletl:pb-lg", "label": "Large - 24px" },
        { "value": "tabletl:pb-xl", "label": "X-Large - 40px" },
        { "value": "tabletl:pb-xxl", "label": "XX-Large - 60px" },
        { "value": "tabletl:pb-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "set_dark_theme",
      "label": "Set Dark Theme",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "apply_gradient",
      "label": "Apply Gradient",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "title_tag",
      "label": "Title Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link Label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link Location"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "hide_arrows_desktop",
      "label": "Hide Arrows Desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "name": "Article Block",
      "type": "block",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Events Carousel"
    }
  ]
}
{% endschema %}
              
