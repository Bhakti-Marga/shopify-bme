{%- liquid 
  assign current_variant = product.selected_or_first_available_variant 
  assign product_form_id = 'ProductForm-' | append: section.id | append: product.id
  assign master_select_id = 'MasterSelect-' | append: section.id
-%}

{%- capture carousel_options -%}
  {
    "slidesPerView": "auto",
    "freeMode": true,
    "touchRatio": 1,
    "momentum": true,
    "mousewheel": {
      "forceToAxis": true
    },
    "loop": false,
    "spaceBetween": "16",
    "pagination": {
      "el": ".swiper-pagination",
      "type": "bullets",
      "clickable": true
    }
  }
{%- endcapture -%}

<s-product role="section" class="product block container py-md tabletl:py-xl" data-section-id="{{ section.id }}">
  <a class="skip-to-content-link sr-only" href="#ProductInfo-{{ section.id }}">Ir a la información del producto</a>
  <div class="product__layout tabletl:grid tabletl:grid-cols-2 tabletl:gap-md">
    <div class="product__images">
      <s-carousel data-init="belowLaptop" data-options='{{carousel_options}}'>
        <div id="ProductMainImages" class="swiper w-full pb-[50px]" js-carousel>
          <div class="swiper-wrapper tabletl:grid tabletl:grid-cols-2 tabletl:gap-md">
            {% for media in product.media %}
              {% assign index_mod_3 = forloop.index | modulo: 3 %}

              {% comment %} Configuración de clases para controlar la altura de las imágenes {% endcomment %}
              {% if index_mod_3 == 1 %}
                {%- comment -%} Imagen Principal: Forzamos una altura máxima de 450px para evitar que sea gigante {%- endcomment -%}
                {% assign slide_classes = 'h-[300px] tabletl:h-[450px] w-full relative z-1 overflow-hidden tabletl:col-span-2' %}
              {% elsif index_mod_3 == 2 or index_mod_3 == 0 %}
                {%- comment -%} Imágenes Secundarias: Proporción 4:3 para que sean simétricas {%- endcomment -%}
                {% assign slide_classes = 'aspect-[4/3] relative z-1 overflow-hidden tabletl:col-span-1' %}
              {% endif %}

              {% case media.media_type %}
                {% when 'image' %}
                  <div class="swiper-slide {{ slide_classes }}" js-carousel-slide>
                    {% render 'lazy-image',
                      image: media,
                      picture_classes: 'w-full h-full',
                      img_classes: 'object-cover w-full h-full rounded'
                    %}
                  </div>
                {% when 'video' %}
                  <div class="swiper-slide {{ slide_classes }}" js-carousel-slide>
                    {{ media | video_tag: controls: true, autoplay: false, loop: true, mute: false, class: 'w-full h-full object-cover block rounded' }}
                  </div>
                {% when 'external_video' %}              
                  <div class="swiper-slide {{ slide_classes }}" js-carousel-slide>
                    <div class="w-full h-full rounded overflow-hidden">
                      {{ media | external_video_tag: class: 'w-full h-full object-cover' }}
                    </div>
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
          <div class="swiper-pagination tabletl:hidden"></div>
        </div>
      </s-carousel>
    </div>

    <div class="product__information h-[min-content] py-lg tabletl:py-xl tabletl:px-xxl tabletl:sticky tabletl:top-[var(--header-height)]" id="ProductInfo-{{ section.id }}">
      <h1 class="product__title h5 leading-tight mb-lg">{{ product.title }}</h1>
      <div class="product__price mb-lg text-18 tabletl:text-20" js-price>{{ current_variant.price | money }}</div>
      
      {% if product.metafields.event.date_time != blank or product.metafields.event.teacher != blank or product.metafields.event.location != blank %}
        <div class="product__event-info-wrapper mb-lg text-18 tabletl:text-20">
          {% if product.metafields.event.date_time != blank %}
            <p class="font-700">{{ product.metafields.event.date_time }}</p>
          {% endif %}
          {% if product.metafields.event.teacher != blank %}
            <p class="mt-sm">{{ product.metafields.event.teacher }}</p>
          {% endif %}
          {% if product.metafields.event.type != blank and product.metafields.event.location != blank %}
            {%- assign event_type = product.metafields.event.type | downcase -%}
            {%- if event_type contains "in-person" -%}
              <p class="mt-sm">{{ product.metafields.event.location }}</p>
            {%- endif -%}
          {% endif %}
          {% if product.metafields.custom.localizacion != blank %}
            {% for loc in product.metafields.custom.localizacion.value %}
              <div class="mt-sm">
                {% if loc.name %}
                  <p class="font-600">{{ loc.name.value }}</p>
                {% endif %}
                {% if loc.latitude and loc.longitude %}
                  <a href="https://www.google.com/maps?q={{ loc.latitude.value }},{{ loc.longitude.value }}" target="_blank" rel="noopener" class="text-16 underline">
                    {{ 'products.product.view_on_maps' | t }}
                  </a>
                {% endif %}
              </div>
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}

      <div class="product__description text-16 mb-lg tabletl:text-18">{{ product.description }}</div>

      {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', js-product-form: true -%}
        {% render 'master-variant-select',
          variants: product.variants,
          id: master_select_id,
          current_variant: current_variant
        %}

        {% unless product.has_only_default_variant %}
          <product-options class="no-js-hidden block" data-product='ProductJSON' data-master-select-id="{{ master_select_id }}" data-enable-history-state>
            {% for option in product.options_with_values %}
              {% render 'product-option-selector',
                option: option,
                type: 'select',
                section_id: section.id,
                product_id: product.id
              %}
            {% endfor %}
          </product-options>
        {% endunless %}

        <div class="form__qty-wrapper mt-lg">
          <label class="form__label inline-block font-600 text-16 mb-md" for="Quantity-{{ section.id }}">
            {%- assign product_type = product.type | downcase -%}
            {%- if product_type contains "event" -%} Asistentes: {%- else -%} Cant.: {%- endif -%}
          </label>
          
          {%- if product_type contains "event" -%}
            <input class="quantity__input hidden" type="number" name="quantity" id="Quantity-{{ section.id }}" min="1" value="1" form="{{ product_form_id }}">
          {%- else -%}
            <quantity-input class="quantity flex justify-between items-center w-[130px] py-12 px-lg border rounded-full mb-lg">
              <button class="quantity__button" name="minus" type="button">&minus;</button>
              <input class="quantity__input w-full bg-transparent text-center font-500 text-20" type="number" name="quantity" id="Quantity-{{ section.id }}" min="1" value="1" form="{{ product_form_id }}">
              <button class="quantity__button" name="plus" type="button">&plus;</button>
            </quantity-input>
          {%- endif -%}
        </div>

        {%- for block in section.blocks -%}
          {% render block %}
        {%- endfor -%}

        <button class="btn btn--gold py-md w-full uppercase relative mt-lg" type="submit" {% unless current_variant.available %} disabled {% endunless %} js-add-to-cart>
          <loading-spinner style="--size: 3rem; --bg-opacity: 100%;"></loading-spinner>
          {% if current_variant.available %} {{ 'products.product.add_to_cart' | t }} {% else %} {{ 'products.product.sold_out' | t }} {% endif %}
        </button>
        <p class="hidden" js-error-message></p>
      {%- endform -%}
    </div>
  </div>

  <script type="application/json" id="ProductJSON">{{ product | json }}</script>
</s-product>