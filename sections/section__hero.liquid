{% capture modal_id %}HeroVideoModal-{{ section.id }}{% endcapture %}
{% capture modal_open_selector %}js-open-modal-hero-{{ section.id }}{% endcapture %}
{% capture modal_close_selector %}js-close-modal-hero-{{ section.id }}{% endcapture %}

{% capture video_thumbnail_markup %}
  {% if section.settings.video_url != blank %}
    <div class="hero__video-trigger">
      {%  if section.settings.video_title != blank %}
        <h3 
          class="video-modal-trigger__title flex items-center text-12 font-500 mb-12"
          style="{% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}"
        >
          <span class="block w-[7px] h-[7px] rounded-full bg-white mr-[8px]"></span>
          <span>{{ section.settings.video_title }}</span>
        </h3>
      {% endif %}
      <div class="hero__video-poster-container relative aspect-video tabletl:w-[384px] tabletl:rounded">
        {% if section.settings.poster_video != blank or section.settings.poster_video_desktop != blank %}
          {% assign video_class = 'rounded w-full h-full object-cover block' %}
          
          {% if section.settings.poster_video != blank %}
            {% if section.settings.poster_video_desktop != blank %}
              {% assign video_class = video_class | append: ' tabletl:hidden' %}
            {% endif %}
            {{ section.settings.poster_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1024x', class: video_class }}
          {% endif %}
          {% if section.settings.poster_video_desktop  != blank %}
            {% if section.settings.poster_video != blank %}
              {% assign video_class = video_class | append: 'hidden tabletl:block' %}
            {% endif %}
            {{ section.settings.poster_video_desktop | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1024x', class: video_class }}
          {% endif %}   
        {% elsif section.settings.poster_image != blank %}
          {% render 'lazy-image',
            image: section.settings.poster_image,
            image_desktop: section.settings.poster_image_desktop,
            img_classes: 'rounded object-cover absolute top-0 left-0 h-full'
          %}
        {% endif %}
        <div class="hero__video-poster-content p-lg absolute inset-0 flex items-center justify-center tabletl:justify-end tabletl:items-end">
          <button
            class="video-modal-trigger btn flex items-center gap-12 bg-opacity-30 text-white py-md px-32 hover:bg-opacity-50 backdrop-blur-[2px]"
            aria-label="Play video"
            {{ modal_open_selector }}
          >
            <span class="video-modal-trigger__icon w-12 h-12 flex items-center justify-center relative -top-[1px]">
              {% render 'icon--play' %}
            </span>

            <span class="video-modal-trigger__text">
              Ver
            </span>
          </button>
        </div>    
      </div>
    </div>
  {% endif %}
{% endcapture %}

{% liquid
  assign container_classes = ""

  if section.settings.margin_top != "pt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.margin_top
  endif

  if section.settings.margin_bottom != "pb-0"
      assign container_classes = container_classes | append: " " | append: section.settings.margin_bottom
  endif

  if section.settings.desktop_margin_top != "inherit" 
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_top
  endif

  if section.settings.desktop_margin_bottom != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_bottom
  endif

  if section.settings.padding_horizontal != "pt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_horizontal
  endif

  if section.settings.desktop_padding_horizontal != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_horizontal
  endif

  assign container_classes = container_classes | strip
%}

<section
  class="hero{% if container_classes != blank %} {{ container_classes }}{% endif %}"
  style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}
  --padding-top: {{ section.settings.padding_top }};
  --padding-bottom: {{ section.settings.padding_bottom}};
  --padding-top-desktop: {% if section.settings.desktop_padding_top != "inherit" %} {{ section.settings.desktop_padding_top }} {% else %} {{ section.settings.padding_top }} {% endif %};
  --padding-bottom-desktop: {% if section.settings.desktop_padding_bottom != "inherit" %} {{section.settings.desktop_padding_bottom}} {% else %} {{section.settings.padding_bottom}} {% endif %};"
>
  <div class="hero__container flex flex-col {% if section.settings.use_container %} container mx-auto {% endif %} {% if section.settings.set_100vh and section.settings.set_100vh_desktop %} screen-height {% elsif section.settings.set_100vh and section.settings.set_100vh_desktop == false %} screen-height--mobile {% elsif section.settings.set_100vh == false and section.settings.set_100vh_desktop %} screen-height--desktop {% endif %}">
    <div
      class="hero__wrapper relative overflow-hidden {% if section.settings.set_100vh and section.settings.set_100vh_desktop %} flex flex-col flex-1 {% elsif section.settings.set_100vh and section.settings.set_100vh_desktop == false %} flex flex-col flex-1 tabletl:block {% elsif section.settings.set_100vh == false and section.settings.set_100vh_desktop %} tabletl:flex tabletl:flex-col tabletl:flex-1 {% endif %}"
      style="{% unless section.settings.set_100vh %} --aspect-ratio: {{ section.settings.aspect_ratio }};{% endunless %} {% unless section.settings.set_100vh_desktop %} --aspect-ratio-desktop: {{ section.settings.aspect_ratio_desktop }};{% endunless %} border-radius: {{ section.settings.border_radius }}px;"
    >
      <div class="hero__image absolute inset-0">
        {% if section.settings.video != blank or section.settings.video_desktop != blank %}
          {% assign video_class = 'w-full h-full object-cover block' %}

          {% if section.settings.video != blank %}
            {% if section.settings.video_desktop != blank %}
              {% assign video_class = video_class | append: ' tabletl:hidden' %}
            {% endif %}
            {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1024x', class: video_class }}
          {% endif %}
          {% if section.settings.video_desktop  != blank %}
            {% if section.settings.video != blank %}
              {% assign video_class = video_class | append: 'hidden tabletl:block' %}
            {% endif %}
            {{ section.settings.video_desktop | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1024x', class: video_class }}
          {% endif %}   
        {% elsif section.settings.image != blank or section.settings.image_desktop != blank %}

          {% if section.settings.image == blank and section.settings.image_desktop != blank %}
            {%
              render 'lazy-image',
              image: section.settings.image_desktop,
              picture_classes: 'w-full h-full',
              img_classes: 'h-full object-cover',
              style:
            %}
          {% else %}
            {%
              render 'lazy-image',
              image: section.settings.image,
              image_desktop: section.settings.image_desktop,
              picture_classes: 'w-full h-full',
              img_classes: 'h-full object-cover',
              style:
            %}
          {% endif %}

        {% endif %}
      </div>
      <div class="hero__content-wrapper relative h-full p-md tabletl:p-xxl {% if section.settings.set_100vh and section.settings.set_100vh_desktop %} flex flex-col flex-1 {% elsif section.settings.set_100vh and section.settings.set_100vh_desktop == false %} flex flex-col flex-1 tabletl:block {% elsif section.settings.set_100vh == false and section.settings.set_100vh_desktop %} tabletl:flex tabletl:flex-col tabletl:flex-1 {% endif %}">
        <div class="hero__content h-full flex gap-lg flex-1 {{ section.settings.horizontal_position }} {{ section.settings.vertical_position }}">
          <div
            class="hero__content-container {{ section.settings.content_width | default: 'max-w-5xl'}} {{ section.settings.text_align }}"
            style="{% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}"
          >
            {% if section.settings.title != blank %}
              <h2 class="hero__title leading-none mb-md {% if section.settings.title_font_style != blank %}{{  section.settings.title_font_style  }}{% endif %}">
                {{ section.settings.title }}
              </h2>  
            {% endif %}

            {% if section.settings.subtitle != blank %}
              <div class="hero__subtitle text-18 font-500 mb-md tabletl:text-20">{{ section.settings.subtitle }}</div>
            {% endif %}

            {% if section.settings.button_text != blank and section.settings.button_url != blank %}
              <a
                {% if section.settings.anchor_to_pricing %} 
                  href="#prices"
                {% else %}
                  href="{{ section.settings.button_url }}"
                {% endif %}
                class="hero__cta {{ section.settings.button_style }} inline-block"
              >
                {{ section.settings.button_text }}
              </a>
            {% endif %}
          </div>

          {% if section.settings.video_url != blank %}
            <div class="hero__video-thumbnail-desktop hidden justify-self-end ml-auto tabletl:block">
              {{ video_thumbnail_markup }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.video_url != blank %}
    <div class="hero__video-thumbnail-mobile container py-lg tabletl:hidden">
      {{ video_thumbnail_markup }}
    </div>
  {% endif %}

  {% render 'video-modal',
    modal_id: modal_id,
    video_title: section.settings.video_title,
    video_url: section.settings.video_url,
    selectors_open: modal_open_selector,
    selectors_close: modal_close_selector
  %}
</section>

