{% liquid
  assign container_classes = ""

  if section.settings.padding_top != "pt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_top
  endif

  if section.settings.padding_bottom != "pb-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_bottom
  endif

  if section.settings.desktop_padding_top != "inherit" 
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_top
  endif

  if section.settings.desktop_padding_bottom != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_bottom
  endif

  assign container_classes = container_classes | strip
%}

<div class="quote-blocks text-white {% if container_classes != blank %} {{ container_classes }}{% endif %}">
  <ul class="quote-blocks__container container grid grid-cols-[var(--column-size-mobile)] tabletl:grid-cols-[var(--column-size)] gap-md"
    style="--column-size-mobile: repeat({{ section.settings.cols_mobile }}, 1fr);
    --column-size: repeat({{ section.settings.cols_desktop }}, 1fr);">
    {% for block in section.blocks %}
      {% if block.settings.title != blank or block.settings.description != blank %}
        <li class="bg-blue text-center rounded py-xxl px-lg tabletl:px-xl">
          {% if block.settings.title != blank %}
            <p class="quote-blocks__title font-600 text-32 leading-tight mb-md">
                {{ block.settings.title }}
            </p>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class="quote-blocks__description rte">
                {{ block.settings.description }}
            </div>
          {% endif %}
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "Quote Blocks",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Padding Top",
      "options": [
        { "value": "pt-0", "label": "None" },
        { "value": "pt-sm", "label": "Small - 8px" },
        { "value": "pt-md", "label": "Medium - 16px" },
        { "value": "pt-lg", "label": "Large - 24px" },
        { "value": "pt-xl", "label": "X-Large - 40px" },
        { "value": "pt-xxl", "label": "XX-Large - 60px" },
        { "value": "pt-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "pt-0"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "options": [
        { "value": "pb-0", "label": "None" },
        { "value": "pb-sm", "label": "Small - 8px" },
        { "value": "pb-md", "label": "Medium - 16px" },
        { "value": "pb-lg", "label": "Large - 24px" },
        { "value": "pb-xl", "label": "X-Large - 40px" },
        { "value": "pb-xxl", "label": "XX-Large - 60px" },
        { "value": "pb-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "pb-0"
    },
    {
      "type": "select",
      "id": "desktop_padding_top",
      "label": "Desktop - Padding Top",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "tabletl:pt-0", "label": "None" },
        { "value": "tabletl:pt-sm", "label": "Small - 8px" },
        { "value": "tabletl:pt-md", "label": "Medium - 16px" },
        { "value": "tabletl:pt-lg", "label": "Large - 24px" },
        { "value": "tabletl:pt-xl", "label": "X-Large - 40px" },
        { "value": "tabletl:pt-xxl", "label": "XX-Large - 60px" },
        { "value": "tabletl:pt-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "tabletl:pt-0"
    },
    {
      "type": "select",
      "id": "desktop_padding_bottom",
      "label": "Desktop - Padding Bottom",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "tabletl:pb-0", "label": "None" },
        { "value": "tabletl:pb-sm", "label": "Small - 8px" },
        { "value": "tabletl:pb-md", "label": "Medium - 16px" },
        { "value": "tabletl:pb-lg", "label": "Large - 24px" },
        { "value": "tabletl:pb-xl", "label": "X-Large - 40px" },
        { "value": "tabletl:pb-xxl", "label": "XX-Large - 60px" },
        { "value": "tabletl:pb-xxxl", "label": "XXX-Large - 80px" }
      ],
      "default": "tabletl:pb-0"
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "text",
      "id": "cols_mobile",
      "label": "Columns per row (mobile)",
      "default": "1"
    },
    {
      "type": "text",
      "id": "cols_desktop",
      "label": "Columns per row (desktop)",
      "default": "3"
    }
  ],
  "blocks": [
    {
      "name": "Text Block",
      "type": "block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quote Blocks"
    }
  ]
}
{% endschema %}
