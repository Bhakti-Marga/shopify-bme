{% assign section_title = section.settings.title | default: 'Nuestras Comunidades' %}
{% assign section_subtitle = section.settings.subtitle | default: 'Encuentra la sangha o templo más cercano a ti' %}

<style>
  .sangha-cards-section {
    background: #f8f7f4;
    padding: 60px 20px;
  }

  .sangha-cards-section__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .sangha-cards-section__title {
    font-size: 32px;
    font-weight: 700;
    color: #16254c;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .sangha-cards-section__subtitle {
    font-size: 16px;
    color: #888;
    margin: 0;
  }

  .sangha-cards-section__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .scards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .scards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .scards-grid {
      grid-template-columns: 1fr;
    }
  }

  .scard {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* OPCIÓN C — ratio portrait 2/3, sin recorte agresivo */
  .scard__img {
    width: 100%;
    aspect-ratio: 2/3;
    object-fit: cover;
    object-position: center 15%;
    display: block;
    flex-shrink: 0;
  }

  .scard__body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .scard__badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: 20px;
    align-self: flex-start;
  }

  .scard__badge--temple {
    background: #D4AF37;
    color: #16254c;
  }

  .scard__badge--sangha {
    background: #16254c;
    color: #fff;
  }

  .scard__name {
    font-size: 18px;
    font-weight: 700;
    color: #16254c;
    margin: 10px 0 4px;
    line-height: 1.3;
  }

  .scard__city {
    font-size: 13px;
    color: #888;
    margin-bottom: 12px;
    margin-top: 0;
  }

  .scard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .scard__tag {
    font-size: 11px;
    background: #f0f0f0;
    color: #555;
    padding: 3px 10px;
    border-radius: 12px;
  }

  .scard__btn {
    display: block;
    background: #16254c;
    color: #fff;
    text-align: center;
    padding: 12px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    margin-top: auto;
    transition: background 0.2s ease;
  }

  .scard__btn:hover {
    background: #0d1a36;
    color: #fff;
    text-decoration: none;
  }
</style>

<section class="sangha-cards-section" id="sangha-cards">
