{%- liquid 
  assign current_variant = product.selected_or_first_available_variant 
  assign product_form_id = 'ProductForm-' | append: section.id | append: product.id
  assign master_select_id = 'MasterSelect-' | append: section.id
-%}

{%- capture carousel_options -%}
  {
    "slidesPerView": "auto",
    "freeMode": true,
    "touchRatio": 1,
    "momentum": true,
    "mousewheel": {
      "forceToAxis": true
    },
    "loop": false,
    "spaceBetween": "16",
    "pagination": {
      "el": ".swiper-pagination",
      "type": "bullets",
      "clickable": true
    }
  }
{%- endcapture -%}

<s-donation role="section" class="product block container py-md tabletl:py-xl" data-section-id="{{ section.id }}">
  <a class="skip-to-content-link sr-only" href="#ProductInfo-{{ section.id }}">Skip to product information</a>
  <div class="product__layout tabletl:grid tabletl:grid-cols-2 tabletl:gap-md">
    <div class="product__images">
      <s-carousel data-init="belowLaptop" data-options='{{carousel_options}}'>
        <div id="ProductMainImages" class="swiper w-full pb-[50px]" js-carousel>
          <div class="swiper-wrapper tabletl:grid tabletl:grid-cols-2 tabletl:gap-md">
            {% for media in product.media %}
              {% assign slide_classes = 'aspect-[7/9] relative z-1 overflow-hidden' %}
              {% assign index_mod_3 = forloop.index | modulo: 3 %}

              {% if index_mod_3 == 1 %}
                {% assign slide_classes = slide_classes | append: ' tabletl:col-span-2' %}
              {% elsif index_mod_3 == 2 or index_mod_3 == 0 %}
                {% assign slide_classes = slide_classes | append: ' tabletl:col-span-1' %}
              {% endif %}

              {% case media.media_type %}
                {% when 'image' %}
                  <div class="swiper-slide {{ slide_classes }}" js-carousel-slide>
                    {% render 'lazy-image',
                      image: media,
                      picture_classes: 'h-full',
                      img_classes: 'object-cover h-full rounded'
                    %}
                  </div>
                {% when 'video' %}
                  <div class="swiper-slide {{ slide_classes }}" js-carousel-slide>
                    {{ media | video_tag: controls: true, autoplay: false, loop: true, mute: false, class: 'w-full h-full object-cover block' }}
                  </div>
                {% when 'external_video' %}              
                  <div class="swiper-slide {{ slide_classes }}" js-carousel-slide>
                    {{ media | external_video_tag }}
                  </div>
                {% endcase %}
            {% endfor %}
          </div>
          <div class="swiper-pagination tabletl:hidden"></div>
        </div>
      </s-carousel>
    </div><!-- .product__images-container -->

    <div class="product__information h-[min-content] py-lg tabletl:py-xl tabletl:px-xxl tabletl:sticky tabletl:top-[var(--header-height)]" id="ProductInfo-{{ section.id }}">
      {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', js-product-form: true -%}

        {%- comment -%} Variant select — required by DonationMain and widget JS {%- endcomment -%}
        <select class="sr-only" id="{{ master_select_id }}" name="id" js-master-select>
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
              {{ variant.title }}
            </option>
          {%- endfor -%}
        </select>

        {%- comment -%} Find "Otro" variant id for custom amount JS routing {%- endcomment -%}
        {%- assign otro_variant_id = '' -%}
        {%- for variant in product.variants -%}
          {%- assign vtitle = variant.title | downcase -%}
          {%- if vtitle == 'otro' or vtitle contains 'otro' or vtitle contains 'otra' -%}
            {%- assign otro_variant_id = variant.id -%}
          {%- endif -%}
        {%- endfor -%}

        <div class="donation-widget"
             id="DonationWidget-{{ section.id }}"
             data-otro-variant="{{ otro_variant_id }}"
             data-section-id="{{ section.id }}">

          <h1 class="product__title h5 leading-tight mb-lg">{{ product.title }}</h1>

          {% if product.description != blank %}
            <div class="donation-widget__description rte text-16 mb-lg tabletl:text-18">{{ product.description }}</div>
          {% endif %}

          <div class="donation-widget__frequency mb-lg" role="group" aria-label="Frecuencia de donación">
            <button type="button" class="donation-freq-btn active" data-freq="once" aria-pressed="true">Una vez</button>
            <button type="button" class="donation-freq-btn" data-freq="monthly" aria-pressed="false">Recurrente</button>
          </div>

          <div class="donation-widget__plans mb-lg" id="DonationPlans-{{ section.id }}" aria-hidden="true" style="display:none">
            <div class="donation-recur">
              <div class="donation-recur__row">
                <label class="donation-recur__label">
                  <input type="radio" name="donation-plan-{{ section.id }}" class="donation-plan-radio" data-plan="mensual" checked> Cada mes
                </label>
                <span class="donation-recur__tag">mensual</span>
              </div>
              <div class="donation-recur__row">
                <label class="donation-recur__label">
                  <input type="radio" name="donation-plan-{{ section.id }}" class="donation-plan-radio" data-plan="trimestral"> Cada 3 meses
                </label>
                <span class="donation-recur__tag">trimestral</span>
              </div>
              <div class="donation-recur__row">
                <label class="donation-recur__label">
                  <input type="radio" name="donation-plan-{{ section.id }}" class="donation-plan-radio" data-plan="semestral"> Cada 6 meses
                </label>
                <span class="donation-recur__tag">semestral</span>
              </div>
              <div class="donation-recur__row">
                <label class="donation-recur__label">
                  <input type="radio" name="donation-plan-{{ section.id }}" class="donation-plan-radio" data-plan="anual"> Cada año
                </label>
                <span class="donation-recur__tag">anual</span>
              </div>
            </div>
          </div>

          <div class="donation-widget__amounts mb-lg">
            <div class="donation-amounts-grid">
              {%- for variant in product.variants -%}
                {%- assign vtitle = variant.title | downcase -%}
                {%- unless vtitle == 'otro' or vtitle contains 'otro' or vtitle contains 'otra' -%}
                  <button type="button"
                          class="donation-amount-btn"
                          data-variant-id="{{ variant.id }}"
                          data-price="{{ variant.price | divided_by: 100.0 }}"
                          {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.price | money_without_trailing_zeros }}
                  </button>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>

          <div class="donation-widget__custom mb-lg">
            <div class="donation-custom__wrapper">
              <span class="donation-custom__prefix" js-currency-symbol aria-hidden="true">€</span>
              <input type="number"
                     class="donation-custom__input"
                     id="DonationCustom-{{ section.id }}"
                     placeholder="Otra cantidad"
                     min="1"
                     step="1"
                     aria-label="Otra cantidad en euros"
                     js-amount-input>
            </div>
          </div>

          <div class="donation-widget__impact mb-lg" id="DonationImpact-{{ section.id }}" aria-live="polite" style="display:none">
            <span class="donation-impact__icon" aria-hidden="true">★</span>
            <span class="donation-impact__text"></span>
          </div>

          {%- comment -%} Hidden controls required by DonationMain JS — do not remove {%- endcomment -%}
          <div class="subscription-container sr-only" aria-hidden="true">
            <label>
              <input type="checkbox" class="sr-only" js-subscription-checkbox>
              <span></span>
            </label>
            <div>
              <select name="selling_plan" js-subscription-select>
                {%- for group in product.selling_plan_groups -%}
                  {%- for plan in group.selling_plans -%}
                    {%- assign plan_freq = plan.name | downcase -%}
                    {%- if plan.name == 'Monthly' -%}{%- assign plan_freq = 'mensual' -%}
                    {%- elsif plan.name == 'Quarterly' -%}{%- assign plan_freq = 'trimestral' -%}
                    {%- elsif plan.name == 'Yearly' or plan.name == 'Annual' -%}{%- assign plan_freq = 'anual' -%}
                    {%- elsif plan.name contains 'Semi' or plan.name contains '6' -%}{%- assign plan_freq = 'semestral' -%}
                    {%- endif -%}
                    <option value="{{ plan.id }}" data-plan="{{ plan_freq }}">{{ plan_freq | capitalize }}</option>
                  {%- endfor -%}
                {%- endfor -%}
              </select>
            </div>
          </div>

          <div class="seal-anchor" id="SealAnchor-{{ section.id }}" aria-hidden="true" style="display:none">
            {%- for block in section.blocks -%}
              {% render block %}
            {%- endfor -%}
          </div>

          <button
            class="btn btn--gold py-md w-full uppercase relative"
            type="submit"
            {% unless current_variant.available %} disabled {% endunless %}
            js-add-to-cart>
            <loading-spinner style="--size: 3rem; --bg-opacity: 100%;"></loading-spinner>
            Donar ahora
          </button>
          <p class="hidden" js-error-message></p>

          <p class="donation-widget__trust text-14 text-center mt-sm">Pago seguro · Tarjeta · Apple Pay · Cancela cuando quieras</p>
        </div><!-- .donation-widget -->

      {%- endform -%}
    </div><!-- .product__information -->
  </div><!-- .product__layout -->

  <script type="application/json" id="ProductJSON">{{ product | json }}</script>

</s-donation>

<style>
/* donation-widget */
.donation-widget__frequency {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #f3efe4;
  padding: 4px;
  border-radius: 999px;
  margin-bottom: 1rem;
}
.donation-freq-btn {
  padding: 0.5625rem 0.75rem;
  background: transparent;
  border: none;
  cursor: pointer;
  font-size: 0.8125rem;
  font-weight: 600;
  color: #2b3a5e;
  border-radius: 999px;
  transition: background-color 0.15s, color 0.15s, box-shadow 0.15s;
  line-height: 1.5;
  text-align: center;
}
.donation-freq-btn.active {
  background-color: #16254c;
  color: #fff;
  box-shadow: 0 1px 0 rgba(0,0,0,.04);
}
.donation-freq-btn:hover:not(.active) {
  background-color: rgba(22,37,76,.06);
}
/* recurring plans list */
.donation-recur {
  background: #fbf9f3;
  border: 1px solid #e7e3d8;
  border-radius: 0.625rem;
  padding: 0.75rem;
}
.donation-recur__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.625rem;
  font-size: 0.8125rem;
}
.donation-recur__row + .donation-recur__row {
  margin-top: 0.5rem;
  padding-top: 0.5rem;
  border-top: 1px dashed #e7e3d8;
}
.donation-recur__label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  color: #2b3a5e;
}
.donation-recur__label input[type="radio"] {
  accent-color: #16254c;
  cursor: pointer;
}
.donation-recur__badge {
  font-size: 0.6875rem;
  color: #7a6533;
  background: #e8dbc0;
  padding: 2px 6px;
  border-radius: 4px;
  white-space: nowrap;
}
.donation-recur__tag {
  font-size: 0.6875rem;
  color: #6b6f7a;
  white-space: nowrap;
}
/* amount grid */
.donation-amounts-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.5rem;
}
.donation-amount-btn {
  padding: 0.875rem 0.5rem;
  border: 1px solid #e7e3d8;
  border-radius: 0.5rem;
  background: #fff;
  cursor: pointer;
  font-size: 1rem;
  font-weight: 600;
  color: #16254c;
  text-align: center;
  transition: all 0.15s ease-out;
  position: relative;
}
.donation-amount-btn:hover:not(.active):not([disabled]) {
  border-color: #16254c;
}
.donation-amount-btn.active {
  border-color: #16254c;
  background: #16254c;
  color: #fff;
}
.donation-amount-btn.active::after {
  content: "✓";
  position: absolute;
  top: 4px;
  right: 6px;
  font-size: 0.625rem;
  opacity: 0.7;
}
.donation-amount-btn[disabled] {
  opacity: 0.4;
  cursor: not-allowed;
}
/* custom amount */
.donation-custom__wrapper {
  display: flex;
  align-items: center;
  border: 1px solid #e7e3d8;
  border-radius: 0.5rem;
  padding: 0 0.875rem;
  background: #fff;
  transition: border-color 0.15s ease-out;
}
.donation-custom__wrapper:focus-within {
  border-color: #16254c;
}
.donation-custom__prefix {
  font-weight: 500;
  color: #6b7280;
  padding-right: 0.5rem;
  border-right: 1px solid #e7e3d8;
  font-size: 0.875rem;
  user-select: none;
  line-height: 1;
}
.donation-custom__input {
  flex: 1;
  border: none;
  padding: 0.875rem;
  font-size: 1rem;
  font-weight: 600;
  color: #16254c;
  background: transparent;
  outline: none;
  width: 100%;
  -moz-appearance: textfield;
}
.donation-custom__input::-webkit-inner-spin-button,
.donation-custom__input::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
/* impact line */
.donation-widget__impact {
  display: flex;
  gap: 0.625rem;
  align-items: flex-start;
  font-size: 0.8125rem;
  color: #2b3a5e;
  background: #fbf9f3;
  border-left: 3px solid #d6bf90;
  padding: 0.625rem 0.75rem;
  border-radius: 0 0.375rem 0.375rem 0;
}
.donation-impact__icon {
  flex-shrink: 0;
  color: #d6bf90;
}
.donation-widget__trust {
  color: #6b7280;
  font-size: 0.8125rem;
}
.seal-anchor,
#infiniteoptions-container {
  display: none !important;
}
</style>

{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {%- if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif -%}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>


<script>
(function() {
  'use strict';

  function initDonationWidget(sectionId) {
    var sectionEl = document.querySelector('s-donation[data-section-id="' + sectionId + '"]');
    if (!sectionEl) return;

    var widgetEl     = sectionEl.querySelector('#DonationWidget-' + sectionId);
    var masterSel    = sectionEl.querySelector('[js-master-select]');
    var amountInput  = sectionEl.querySelector('[js-amount-input]');
    var subCheckbox  = sectionEl.querySelector('[js-subscription-checkbox]');
    var subSelect    = sectionEl.querySelector('[js-subscription-select]');
    var plansPanel   = sectionEl.querySelector('#DonationPlans-' + sectionId);
    var impactEl     = sectionEl.querySelector('#DonationImpact-' + sectionId);
    var otroVariantId = widgetEl ? widgetEl.dataset.otroVariant : null;
    var ioInput      = null;

    if (!widgetEl || !masterSel) return;

    var state = { freq: 'once', plan: 'mensual' };

    /* Frequency toggle */
    sectionEl.querySelectorAll('[data-freq]').forEach(function(btn) {
      btn.addEventListener('click', function() { setFreq(btn.dataset.freq); });
    });

    function setFreq(freq) {
      state.freq = freq;
      sectionEl.querySelectorAll('[data-freq]').forEach(function(b) {
        var on = b.dataset.freq === freq;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (freq === 'monthly') {
        plansPanel.style.display = '';
        plansPanel.setAttribute('aria-hidden', 'false');
        var activePlan = state.plan || 'mensual';
        var firstRadio = sectionEl.querySelector('.donation-plan-radio[data-plan="' + activePlan + '"]')
                      || sectionEl.querySelector('.donation-plan-radio');
        if (firstRadio && !firstRadio.checked) firstRadio.checked = true;
        selectPlan(firstRadio ? firstRadio.dataset.plan : activePlan);
        if (subCheckbox) { subCheckbox.checked = true; subCheckbox.dispatchEvent(new Event('change', { bubbles: true })); }
      } else {
        plansPanel.style.display = 'none';
        plansPanel.setAttribute('aria-hidden', 'true');
        if (subCheckbox) { subCheckbox.checked = false; subCheckbox.dispatchEvent(new Event('change', { bubbles: true })); }
      }
    }

    /* Plan radios */
    sectionEl.querySelectorAll('.donation-plan-radio').forEach(function(radio) {
      radio.addEventListener('change', function() {
        if (radio.checked) selectPlan(radio.dataset.plan);
      });
    });

    function selectPlan(planName) {
      state.plan = planName;
      sectionEl.querySelectorAll('.donation-plan-radio').forEach(function(r) {
        r.checked = (r.dataset.plan === planName);
      });
      /* Wire to DonationMain's subscription select */
      if (subSelect) {
        var opt = subSelect.querySelector('option[data-plan="' + planName + '"]');
        if (opt) {
          subSelect.value = opt.value;
          subSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
    }

    /* Amount buttons */
    sectionEl.querySelectorAll('[data-variant-id]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (btn.disabled) return;
        clearCustomField();
        setActiveAmountBtn(btn);
        setVariant(btn.dataset.variantId);
        if (amountInput) amountInput.value = parseFloat(btn.dataset.price).toFixed(2).replace(/\.00$/, '');
        showImpact(parseFloat(btn.dataset.price));
      });
    });

    function setActiveAmountBtn(activeBtn) {
      sectionEl.querySelectorAll('[data-variant-id]').forEach(function(b) {
        b.classList.toggle('active', b === activeBtn);
      });
    }

    function setVariant(variantId) {
      if (!masterSel) return;
      masterSel.value = variantId;
      masterSel.dispatchEvent(new Event('change', { bubbles: true }));
    }

    /* Custom amount (amountInput is also [js-amount-input] so DonationMain reads it directly) */
    if (amountInput) {
      amountInput.addEventListener('input', handleCustomInput);
    }

    function handleCustomInput() {
      var val = (amountInput.value || '').trim();
      if (!val || parseFloat(val) <= 0) {
        clearIO();
        return;
      }
      sectionEl.querySelectorAll('[data-variant-id]').forEach(function(b) { b.classList.remove('active'); });
      if (state.freq === 'monthly') { setFreq('once'); }
      syncIO(val);
      if (otroVariantId) {
        setVariant(otroVariantId);
      } else {
        var firstOpt = masterSel.options[0];
        if (firstOpt) setVariant(firstOpt.value);
      }
      showImpact(parseFloat(val));
    }

    function syncIO(val) {
      resolveIO();
      if (ioInput) {
        ioInput.value = val;
        ioInput.dispatchEvent(new Event('input', { bubbles: true }));
        ioInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    function clearIO() {
      resolveIO();
      if (ioInput) ioInput.value = '';
    }

    function resolveIO() {
      if (ioInput) return;
      var container = document.querySelector('#infiniteoptions-container');
      if (container) {
        ioInput = container.querySelector('input[type="text"], input[type="number"], textarea');
      }
    }

    function clearCustomField() {
      if (amountInput) amountInput.value = '';
      clearIO();
    }

    /* Impact line */
    function showImpact(amount) {
      if (!impactEl) return;
      var textEl = impactEl.querySelector('.donation-impact__text');
      if (!amount || isNaN(amount) || amount <= 0) {
        impactEl.style.display = 'none';
        if (textEl) textEl.textContent = '';
        return;
      }
      var suffix = (state.freq === 'monthly') ? ' al mes' : '';
      var msg = 'Tu donación de <b>' + Math.round(amount) + '€' + suffix + '</b> ayuda a sostener la comunidad.';
      if (textEl) textEl.innerHTML = msg;
      impactEl.style.display = 'flex';
    }

    /* Auto-select first preset on load */
    var firstBtn = sectionEl.querySelector('[data-variant-id]');
    if (firstBtn && !firstBtn.disabled) {
      firstBtn.classList.add('active');
      setVariant(firstBtn.dataset.variantId);
      if (amountInput) amountInput.value = parseFloat(firstBtn.dataset.price).toFixed(2).replace(/\.00$/, '');
      showImpact(parseFloat(firstBtn.dataset.price));
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { initDonationWidget('{{ section.id }}'); });
  } else {
    initDonationWidget('{{ section.id }}');
  }
})();
</script>

{% schema %}
{
  "name": "Donation",
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
