{% liquid
  assign container_classes = ""

  if section.settings.margin_top != "mt-0"
    assign container_classes = container_classes | append: " " | append: section.settings.margin_top
  endif

  if section.settings.margin_bottom != "mb-0"
    assign container_classes = container_classes | append: " " | append: section.settings.margin_bottom
  endif

  if section.settings.desktop_margin_top != "inherit"
    assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_top
  endif

  if section.settings.desktop_margin_bottom != "inherit"
    assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_bottom
  endif

  if section.settings.padding_top != "pt-0"
    assign container_classes = container_classes | append: " " | append: section.settings.padding_top
  endif

  if section.settings.padding_bottom != "pb-0"
    assign container_classes = container_classes | append: " " | append: section.settings.padding_bottom
  endif

  if section.settings.desktop_padding_top != "inherit"
    assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_top
  endif

  if section.settings.desktop_padding_bottom != "inherit"
    assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_bottom
  endif

  assign container_classes = container_classes | strip
%}

<section id="featured-master-{{ section.id }}">
  <div class="{{ container_classes }}">
    {% if section.settings.title != blank or section.settings.content != blank %}
      <div class="container my-xl flex flex-col tabletl:flex-row gap-4">
        {% if section.settings.title != blank %}
          <h2 class="leading-64 h3 tabletl:w-3/5">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.content != blank %}
          <div class="rte text-18 leading-28 tabletl:w-2/5 tabletl:pt-12">
            {{ section.settings.content }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="grid grid-cols-1 overflow-hidden my-md">
      <div class="marquee-block"
        style="--marquee-speed:{{ section.settings.marquee_speed }}s;">
        {% assign total_cols_number = 0 %}
        {% assign total_blocks_number = 0 %}
        {% for block in section.blocks %}
          {% assign total_cols_number = total_cols_number | plus: block.settings.col-span %}
          {% assign total_blocks_number  = total_blocks_number  | plus: 1 %}
        {% endfor %}

        {% capture section_blocks_markup %}
          {% for block in section.blocks %}
            {% if block.settings.image %}
              <div 
                class="{{ block.settings.height-desktop }} h-auto overflow-hidden flex-shrink-0 mx-sm marquee-item min-w-[var(--col-min-width)] w-[var(--col-width)]"
                style="--col-width: calc(((100vw - {{ total_blocks_number }} * 16px - 16px) / {{ total_cols_number }}) * {{ block.settings.col-span }});
                --col-min-width:calc(50px * {{ block.settings.col-span }});"
              >
                {% render 'lazy-image',
                  image: block.settings.image,
                  img_classes: 'h-full object-cover rounded',
                  picture_classes: 'h-full'
                %}
              </div>
            {% endif %}
          {% endfor %}
        {% endcapture %}

        {% comment %} Render twice to fill marquee space {% endcomment %}
        {% for i in (1..2) %}
          {{ section_blocks_markup }}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

