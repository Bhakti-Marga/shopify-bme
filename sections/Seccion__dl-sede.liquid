{% render 'dl-styles' %}
{%- liquid
  assign s = section.settings
-%}
<div class="dv-scope">
  <section class="dl-venue dv-pad">
    <div class="dl-venue__grid">
      <div class="dl-venue__media">
        {%- if s.image != blank -%}{{ s.image | image_url: width: 1200 | image_tag: alt: s.title, loading: 'lazy' }}{%- endif -%}
      </div>
      <div class="dl-venue__body">
        {%- if s.eyebrow != blank -%}<p class="dv-sec-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.title != blank -%}<h2 class="dv-sec-title">{{ s.title }}</h2>{%- endif -%}
        {%- if s.body != blank -%}<div class="dv-sec-body" style="margin-top:14px">{{ s.body }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="dl-venue__list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="dl-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-7-7.5-7-13a7 7 0 1 1 14 0c0 5.5-7 13-7 13z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
                <div>
                  {%- if block.settings.label != blank -%}<strong>{{ block.settings.label }}</strong>{%- endif -%}
                  {{ block.settings.value }}
                  {%- if block.settings.sub != blank -%}<div class="dl-venue__addr">{{ block.settings.sub }}</div>{%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="dl-venue__ctas">
          {%- if s.btn1_text != blank -%}<a href="{{ s.btn1_link | default: '#' }}" target="_blank" rel="noopener" class="dv-btn dv-btn--navy">{{ s.btn1_text }}</a>{%- endif -%}
          {%- if s.btn2_text != blank -%}<a href="{{ s.btn2_link | default: '#' }}" class="dv-btn dv-btn--outline">{{ s.btn2_text }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>
{% stylesheet %}
  .dv-scope .dl-venue{background:var(--white)}
  .dv-scope .dl-venue__grid{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;max-width:1180px;margin:0 auto;padding:0 24px}
  @media (max-width:700px){.dv-scope .dl-venue__grid{grid-template-columns:1fr;gap:32px}}
  .dv-scope .dl-venue__media{aspect-ratio:5/4;border-radius:18px;overflow:hidden;position:relative;box-shadow:0 20px 50px -20px rgba(22,37,76,.3);background:var(--cream-soft)}
  .dv-scope .dl-venue__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .dv-scope .dl-venue__list{margin:24px 0 28px;padding:0;list-style:none;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}
  .dv-scope .dl-venue__list li{display:flex;align-items:flex-start;gap:14px;padding:16px 0;border-bottom:1px solid var(--rule);font-size:15px;line-height:1.55;color:var(--ink)}
  .dv-scope .dl-venue__list li:last-child{border-bottom:0}
  .dv-scope .dl-venue__list strong{display:block;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-deep);font-weight:700;margin-bottom:4px}
  .dv-scope .dl-ico{width:36px;height:36px;border-radius:50%;flex-shrink:0;background:var(--cream);display:flex;align-items:center;justify-content:center;color:var(--navy)}
  .dv-scope .dl-venue__addr{color:var(--muted);font-size:14px;margin-top:2px}
  .dv-scope .dl-venue__ctas{display:flex;gap:12px;flex-wrap:wrap}
{% endstylesheet %}
{% schema %}
{
  "name": "Darshan · Sede",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "La sede" },
    { "type": "text", "id": "title", "label": "Título", "default": "Hotel Beatriz Costa y Spa" },
    { "type": "richtext", "id": "body", "label": "Texto" },
    { "type": "image_picker", "id": "image", "label": "Imagen de la sede" },
    { "type": "header", "content": "Botones" },
    { "type": "text", "id": "btn1_text", "label": "Botón 1 · texto", "default": "Cómo llegar" },
    { "type": "url", "id": "btn1_link", "label": "Botón 1 · enlace" },
    { "type": "text", "id": "btn2_text", "label": "Botón 2 · texto", "default": "Reservar mi plaza" },
    { "type": "url", "id": "btn2_link", "label": "Botón 2 · enlace" }
  ],
  "blocks": [
    { "type": "dato", "name": "Dato", "settings": [
      { "type": "text", "id": "label", "label": "Etiqueta", "default": "Dirección" },
      { "type": "text", "id": "value", "label": "Valor" },
      { "type": "text", "id": "sub", "label": "Subtexto" }
    ] }
  ],
  "presets": [{ "name": "Darshan · Sede" }]
}
{% endschema %}
