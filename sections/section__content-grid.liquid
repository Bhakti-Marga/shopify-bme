{% liquid
  assign container_classes = ""
  assign grid_gap_classes = ""

  if section.settings.margin_top != "mt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.margin_top
  endif

  if section.settings.margin_bottom != "mb-0"
      assign container_classes = container_classes | append: " " | append: section.settings.margin_bottom
  endif

  if section.settings.desktop_margin_top != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_top
  endif

  if section.settings.desktop_margin_bottom != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_bottom
  endif

  if section.settings.padding_top != "pt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_top
  endif

  if section.settings.padding_bottom != "pb-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_bottom
  endif

  if section.settings.desktop_padding_top != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_top
  endif

  if section.settings.desktop_padding_bottom != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_bottom
  endif

  if section.settings.horizontal_gap_mobile != "gap-x-0"
    assign grid_gap_classes = grid_gap_classes | append: " " | append: section.settings.horizontal_gap_mobile
  endif

  if section.settings.vertical_gap_mobile != "gap-y-0"
    assign grid_gap_classes = grid_gap_classes | append: " " | append: section.settings.vertical_gap_mobile
  endif

  if section.settings.horizontal_gap_desktop != "inherit"
    assign grid_gap_classes = grid_gap_classes | append: " " | append: section.settings.horizontal_gap_desktop
  endif

  if section.settings.vertical_gap_desktop != "inherit"
    assign grid_gap_classes = grid_gap_classes | append: " " | append: section.settings.vertical_gap_desktop
  endif

  assign container_classes = container_classes | strip
  assign grid_gap_classes = grid_gap_classes | strip
%}

<section class="content-grid {% if container_classes != blank %} {{ container_classes }}{% endif %}"
  style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  <ul class="container grid grid-cols-[var(--column-size-mobile)] tabletl:grid-cols-[var(--column-size)] {% if grid_gap_classes != blank %} {{ grid_gap_classes }}{% endif %}"
    style="--column-size-mobile: repeat({{ section.settings.cols_mobile }}, 1fr);
    --column-size: repeat({{ section.settings.cols_desktop }}, 1fr);
    --text-color:{{ section.settings.text_color | default: '#000' }};">
    {% for block in section.blocks %}
      {% if block.settings.title != blank or block.settings.description != blank or block.settings.image != blank %}
        <li
          class="{%- if section.settings.format == 'inside' %} pt-[50%] tabletp:pt-0 tabletp:aspect-[6/5] relative z-1 rounded overflow-hidden flex flex-col justify-end {% else %} grid grid-cols-2 gap-md {% endif -%}"
        >
          {% if block.settings.image != blank %}
            <div class="{%- if section.settings.format == 'inside' %} absolute inset-0 -z-1 h-full {% else %} aspect-video {% endif -%}">
              {% render 'lazy-image',
                image: block.settings.image,
                image_desktop: block.settings.desktop_image,
                picture_classes: 'h-full',
                img_classes: 'object-cover h-full'
              %} 
            </div>
          {% endif %}
          {% if section.settings.apply_gradient %}
            <div class="absolute inset-0" style="background: linear-gradient(transparent {{ section.settings.gradient_height }}%, {{ section.settings.gradient_color }} 100%);"></div>
          {% endif %}
          <div class="text-[var(--text-color)]{% if section.settings.format == 'inside' %} relative p-md tabletl:p-32{% endif %}">
            {% if block.settings.title != blank %}
              <{{ block.settings.title_tag }} class="content-grid__title leading-tight mb-sm {% if block.settings.title_font_style != blank %}{{  block.settings.title_font_style  }}{% endif %}">
                  {{ block.settings.title }}
              </{{ block.settings.title_tag }}>  
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="content-grid__description rte">
                {{ block.settings.description }}
              </div>
            {% endif %}
            {% if block.settings.cta_klaviyo_embed != blank %}
              <button class="klaviyo_form_trigger-{{ block.settings.cta_klaviyo_embed }} {{ block.settings.cta_style }} inline-block mt-md">{{ block.settings.cta_label }}</button>
              <script type="text/javascript">
                document.querySelector('.klaviyo_form_trigger-{{ block.settings.cta_klaviyo_embed }}').addEventListener('click', function (){
                  window._klOnsite = window._klOnsite || []; 
                  window._klOnsite.push(['openForm', '{{ block.settings.cta_klaviyo_embed }}']);
                });
              </script>
            {% elsif block.settings.cta_label != blank and block.settings.cta_link != blank %}
              <a
                class="{{ block.settings.cta_style }} inline-block mt-md"
                href="{{ block.settings.cta_link }}"
              >
                {{ block.settings.cta_label }}
              </a>
            {% endif %}
          </div> 
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</section>

