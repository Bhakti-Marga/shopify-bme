{% if product.metafields.custom.profesores != blank %}
  <div class="container py-xl">
    <h3 style="margin-bottom: 16px;">Encuentra tu profesor</h3>
    {% for profesor in product.metafields.custom.profesores.value %}
      <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
        {% if profesor.photo %}
          <img src="{{ profesor.photo | image_url: width: 120 }}" alt="{{ profesor.name }}" style="width:120px;height:120px;object-fit:cover;flex-shrink:0;">
        {% endif %}
        <div>
          <p style="margin: 0;"><strong>{{ profesor.name }}</strong></p>
          <p style="margin: 0;">📍 {{ profesor.city }}</p>
          <p style="margin-top: 8px;">{{ profesor.descripcion_corta }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Profesores",
  "limit": 1
}
{% endschema %}