{% liquid
  assign container_classes = ""

  if section.settings.margin_top != "mt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.margin_top
  endif

  if section.settings.margin_bottom != "mb-0"
      assign container_classes = container_classes | append: " " | append: section.settings.margin_bottom
  endif

  if section.settings.desktop_margin_top != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_top
  endif

  if section.settings.desktop_margin_bottom != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_bottom
  endif

  if section.settings.padding_top != "pt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_top
  endif

  if section.settings.padding_bottom != "pb-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_bottom
  endif

  if section.settings.desktop_padding_top != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_top
  endif

  if section.settings.desktop_padding_bottom != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_bottom
  endif

  assign container_classes = container_classes | strip
%}

<section class="our-values container {% if container_classes != blank %} {{ container_classes }}{% endif %}">
  <div class="our-values__content-wrapper relative tabletl:flex">
    <div class="our-values__content flex flex-col justify-center w-full tabletl:w-1/2">
      <div class="mb-lg">
        {% if section.settings.title != blank %}
          <{{ section.settings.title_tag }} class="font-600 text-48 leading-tight tabletl:text-56">
              {{ section.settings.title }}
          </{{ section.settings.title_tag }}>  
        {% endif %}
        {% if section.settings.content != blank %}
          <div class="rte">
            {{ section.settings.content }}
          </div>  
        {% endif %}
      </div>
        <ul class="our-values__list">
          {%- for block in section.blocks -%}
            <li class="our-values__list-item flex group py-md tabletl:py-lg">           
              <div class="flex items-center gap-md">
                {% if block.settings.title != blank %}
                  {% if block.settings.cta_link %}
                    {% assign tag = 'a' %}
                  {% else %}
                    {% assign tag = 'div' %}
                  {% endif %}
                  <{{ tag }} {% if tag == 'a' %} href="{{ block.settings.cta_link }}"{% endif %}
                    class="our-values__text-link inline-block leading-none duration-500 font-600 text-32 tabletl:text-40"
                  >
                    {{ block.settings.title }} 
                  </{{ tag }}>
                {% endif %}
                {% if block.settings.cta_label != blank and block.settings.cta_link != blank %}
                  <a
                    class="our-values__button {{ block.settings.cta_style }} opacity-0 hidden items-center text-white duration-300 tabletl:flex tabletl:group-hover:opacity-100"
                    href="{{ block.settings.cta_link }}"
                  >{{ block.settings.cta_label }}
                  <i class="inline-block ml-sm w-md -rotate-90 duration-500">{% render 'icon--caret' %}</i></a>
                {% endif %}
              </div>   
              {% if block.settings.image != blank %}
                <div class="hidden opacity-0 rounded duration-500 tabletl:block tabletl:w-[48%] aspect-landscape tabletl:aspect-square tabletl:absolute tabletl:top-1/2 tabletl:-translate-y-1/2 tabletl:right-0 tabletl:group-hover:opacity-100 pointer-events-none">
                  {% render 'lazy-image',
                    image: block.settings.image,
                    picture_classes: 'w-full h-full',
                    img_classes: 'object-cover rounded absolute top-0 left-0 h-full'
                  %} 
                </div>
              {% endif %}  
            </li>
          {% endfor %}
        </ul>

    </div>
    <div class="mt-md tabletl:mt-0 tabletl:w-[48%] tabletl:ml-[2%] flex items-center">
      {% if section.settings.image != blank%}
        <div class="our-values__image rounded relative w-full aspect-[4/3] tabletl:aspect-square tabletl:static">
          {% render 'lazy-image',
            image: section.settings.image,
            picture_classes: 'h-full',
            img_classes: 'object-cover absolute top-0 left-0 h-full rounded tabletl:static'
          %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

