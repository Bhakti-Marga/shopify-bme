{% liquid
  assign city       = section.settings.city_name    | default: 'Nuestra Sangha'
  assign cta_label  = section.settings.hero_cta_label | default: 'Contáctanos'
  assign cta_url    = section.settings.hero_cta_url  | default: '#conectemos'
  assign w_line1    = section.settings.welcome_line1 | default: 'No importa en qué punto de tu camino espiritual estés,'
  assign w_line2    = section.settings.welcome_line2 | default: 'eres bienvenido aquí.'
  assign r_title    = section.settings.reuniones_title | default: 'Reuniones'
%}

<style>
  #csg-{{ section.id }} {
    --csg-navy:      #14224a;
    --csg-navy-deep: #0f1a3a;
    --csg-gold:      #c9b377;
    --csg-cream:     #f4efe5;
    --csg-cream-soft:#f8f4ec;
    --csg-ink:       #14224a;
    --csg-muted:     #5a6378;
    --csg-font:      "Avenir Next", "Nunito Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-family: var(--csg-font);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  #csg-{{ section.id }} * { box-sizing: border-box; }
  #csg-{{ section.id }} img { max-width: 100%; display: block; }

  /* Hero */
  #csg-{{ section.id }} .csg-hero {
    background: var(--csg-navy);
    color: #fff;
    text-align: center;
    padding: 96px 24px 140px;
    position: relative;
    overflow: hidden;
  }
  #csg-{{ section.id }} .csg-hero__bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    opacity: 0.2;
  }
  #csg-{{ section.id }} .csg-hero__inner {
    position: relative; max-width: 1100px; margin: 0 auto;
  }
  #csg-{{ section.id }} .csg-eyebrow {
    color: var(--csg-gold);
    font-size: 16px; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase;
    margin: 0 0 28px;
  }
  #csg-{{ section.id }} .csg-h1 {
    font-family: var(--csg-font);
    font-size: clamp(3rem, 8vw, 88px);
    line-height: 1.02; letter-spacing: -0.02em;
    font-weight: 600; margin: 0 0 32px; color: #fff;
  }
  #csg-{{ section.id }} .csg-lede {
    font-size: 17px; line-height: 1.7;
    max-width: 640px; margin: 0 auto 40px;
    color: rgba(255,255,255,0.88);
  }
  #csg-{{ section.id }} .csg-btn-ghost {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 16px 36px; border-radius: 999px;
    font-size: 16px; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; text-decoration: none;
    border: 1.5px solid rgba(255,255,255,0.85);
    color: #fff; background: transparent;
    cursor: pointer;
    transition: background .18s ease, color .18s ease;
    font-family: var(--csg-font);
  }
  #csg-{{ section.id }} .csg-btn-ghost:hover { background: #fff; color: var(--csg-navy); }

  /* Welcome */
  #csg-{{ section.id }} .csg-welcome {
    background: var(--csg-cream-soft);
    text-align: center; padding: 120px 24px 100px;
  }
  #csg-{{ section.id }} .csg-welcome h2 {
    font-family: var(--csg-font);
    font-size: clamp(1.8rem, 4vw, 56px);
    line-height: 1.15; letter-spacing: -0.01em;
    font-weight: 700; margin: 0 auto;
    max-width: 1100px; color: var(--csg-ink);
  }
  #csg-{{ section.id }} .csg-welcome h2 em {
    font-style: italic; font-weight: 500;
  }

  /* Gallery */
  #csg-{{ section.id }} .csg-gallery {
    background: var(--csg-cream-soft);
    padding: 0 24px 120px;
  }
  #csg-{{ section.id }} .csg-gallery-grid {
    max-width: 1280px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
  }
  @media (max-width: 768px) {
    #csg-{{ section.id }} .csg-gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    #csg-{{ section.id }} .csg-gallery-grid { grid-template-columns: 1fr; }
  }
  #csg-{{ section.id }} .csg-photo {
    aspect-ratio: 4 / 3;
    background: #d9dde6; border-radius: 4px;
    overflow: hidden; position: relative;
  }
  #csg-{{ section.id }} .csg-photo img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }

  /* Reuniones */
  #csg-{{ section.id }} .csg-reuniones {
    background: #fff;
    padding: 140px 24px; text-align: center;
  }
  #csg-{{ section.id }} .csg-reuniones-inner {
    max-width: 720px; margin: 0 auto; text-align: center;
  }
  #csg-{{ section.id }} .csg-reuniones h2 {
    font-family: var(--csg-font);
    font-size: clamp(3rem, 8vw, 88px);
    line-height: 1.02; letter-spacing: -0.02em;
    font-weight: 700; margin: 0 0 72px; color: var(--csg-ink);
  }
  #csg-{{ section.id }} .csg-group { margin: 0 0 40px; }
  #csg-{{ section.id }} .csg-group h3 {
    font-family: var(--csg-font);
    font-size: 18px; font-weight: 700; font-style: italic;
    margin: 0 0 12px; color: var(--csg-ink);
  }
  #csg-{{ section.id }} .csg-group p,
  #csg-{{ section.id }} .csg-group .rte p {
    margin: 0; font-size: 16px; font-style: italic;
    color: var(--csg-ink); line-height: 1.7;
  }
  #csg-{{ section.id }} .csg-group a {
    color: var(--csg-ink); font-weight: 700;
    font-style: italic; text-decoration: underline;
    text-underline-offset: 3px;
  }
  #csg-{{ section.id }} .csg-group--stay { margin-top: 8px; }
  #csg-{{ section.id }} .csg-group--stay strong { display: block; font-weight: 700; margin-bottom: 6px; }
</style>

<div id="csg-{{ section.id }}">

  {%- comment -%}── HERO ──{%- endcomment -%}
  <section class="csg-hero">
    {%- if section.settings.hero_image != blank -%}
      <div class="csg-hero__bg" style="background-image: url('{{ section.settings.hero_image | image_url: width: 1800 }}');"></div>
    {%- endif -%}
    <div class="csg-hero__inner">
      <p class="csg-eyebrow">{{ section.settings.hero_eyebrow | default: 'SANGHA' }}</p>
      <h1 class="csg-h1">{{ city }}</h1>
      {%- if section.settings.hero_subtitle != blank -%}
        <p class="csg-lede">{{ section.settings.hero_subtitle }}</p>
      {%- endif -%}
      <a class="csg-btn-ghost" href="{{ cta_url }}">{{ cta_label }}</a>
    </div>
  </section>

  {%- comment -%}── WELCOME ──{%- endcomment -%}
  <section class="csg-welcome">
    <h2>
      <strong>{{ w_line1 }}</strong>
      {% if w_line2 != blank %} <em>{{ w_line2 }}</em>{% endif %}
    </h2>
  </section>

  {%- comment -%}── PHOTO GRID ──{%- endcomment -%}
  {%- assign has_gallery = false -%}
  {%- for i in (1..6) -%}
    {%- assign img_key = 'gallery_' | append: i -%}
    {%- if section.settings[img_key] != blank -%}{%- assign has_gallery = true -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if has_gallery -%}
  <section class="csg-gallery">
    <div class="csg-gallery-grid" role="list" aria-label="Galería de imágenes de la comunidad">
      {%- for i in (1..6) -%}
        {%- assign img_key = 'gallery_' | append: i -%}
        {%- assign alt_key = 'gallery_' | append: i | append: '_alt' -%}
        {%- if section.settings[img_key] != blank -%}
        <div class="csg-photo" role="listitem">
          <img
            src="{{ section.settings[img_key] | image_url: width: 800 }}"
            alt="{{ section.settings[alt_key] | default: city | append: ' foto ' | append: i }}"
            loading="lazy"
            width="800"
            height="600"
          >
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%}── REUNIONES ──{%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
  <section class="csg-reuniones" id="conectemos">
    <div class="csg-reuniones-inner">
      <h2>{{ r_title }}</h2>
      {%- for block in section.blocks -%}
        {%- if block.type == 'group' -%}
          <div class="csg-group{% if block.settings.is_stay %} csg-group--stay{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3>{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="rte">{{ block.settings.body }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
              <p><a href="{{ block.settings.link_url }}">{{ block.settings.link_label }}</a></p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Comunidad Sangha",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen de fondo (opcional)"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "SANGHA"
    },
    {
      "type": "text",
      "id": "city_name",
      "label": "Nombre de la ciudad",
      "default": "Nuestra Sangha"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Subtítulo del hero"
    },
    {
      "type": "text",
      "id": "hero_cta_label",
      "label": "Texto del botón",
      "default": "Contáctanos"
    },
    {
      "type": "url",
      "id": "hero_cta_url",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Bienvenida"
    },
    {
      "type": "text",
      "id": "welcome_line1",
      "label": "Primera línea (negrita)",
      "default": "No importa en qué punto de tu camino espiritual estés,"
    },
    {
      "type": "text",
      "id": "welcome_line2",
      "label": "Segunda línea (cursiva)",
      "default": "eres bienvenido aquí."
    },
    {
      "type": "header",
      "content": "Galería (6 fotos)"
    },
    {
      "type": "image_picker",
      "id": "gallery_1",
      "label": "Foto 1"
    },
    {
      "type": "text",
      "id": "gallery_1_alt",
      "label": "Texto alternativo foto 1"
    },
    {
      "type": "image_picker",
      "id": "gallery_2",
      "label": "Foto 2"
    },
    {
      "type": "text",
      "id": "gallery_2_alt",
      "label": "Texto alternativo foto 2"
    },
    {
      "type": "image_picker",
      "id": "gallery_3",
      "label": "Foto 3"
    },
    {
      "type": "text",
      "id": "gallery_3_alt",
      "label": "Texto alternativo foto 3"
    },
    {
      "type": "image_picker",
      "id": "gallery_4",
      "label": "Foto 4"
    },
    {
      "type": "text",
      "id": "gallery_4_alt",
      "label": "Texto alternativo foto 4"
    },
    {
      "type": "image_picker",
      "id": "gallery_5",
      "label": "Foto 5"
    },
    {
      "type": "text",
      "id": "gallery_5_alt",
      "label": "Texto alternativo foto 5"
    },
    {
      "type": "image_picker",
      "id": "gallery_6",
      "label": "Foto 6"
    },
    {
      "type": "text",
      "id": "gallery_6_alt",
      "label": "Texto alternativo foto 6"
    },
    {
      "type": "header",
      "content": "Reuniones"
    },
    {
      "type": "text",
      "id": "reuniones_title",
      "label": "Título de la sección",
      "default": "Reuniones"
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Grupo de información",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título del grupo"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Contenido"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texto del enlace (opcional)"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "URL del enlace (opcional)"
        },
        {
          "type": "checkbox",
          "id": "is_stay",
          "label": "Estilo especial (estancias)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comunidad Sangha",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "heading": "Horarios"
          }
        },
        {
          "type": "group",
          "settings": {
            "heading": "Dirección"
          }
        },
        {
          "type": "group",
          "settings": {
            "heading": "Contáctanos"
          }
        }
      ]
    }
  ]
}
{% endschema %}
