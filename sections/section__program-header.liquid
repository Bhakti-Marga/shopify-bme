{% liquid
  assign container_margin_classes = ""
  assign container_top_padding_classes = ""
  assign container_bottom_padding_classes = ""

  if section.settings.margin_top != "mt-0"
    assign container_margin_classes = container_margin_classes | append: " " | append: section.settings.margin_top
  endif

  if section.settings.margin_bottom != "mb-0"
    assign container_margin_classes = container_margin_classes | append: " " | append: section.settings.margin_bottom
  endif

  if section.settings.desktop_margin_top != "inherit"
    assign container_margin_classes = container_margin_classes | append: " " | append: section.settings.desktop_margin_top
  endif

  if section.settings.desktop_margin_bottom != "inherit"
    assign container_margin_classes = container_margin_classes | append: " " | append: section.settings.desktop_margin_bottom
  endif

  if section.settings.padding_top != "pt-0"
      assign container_top_padding_classes = container_top_padding_classes | append: " " | append: section.settings.padding_top
  endif

  if section.settings.padding_bottom != "pb-0"
      assign container_bottom_padding_classes = container_bottom_padding_classes | append: " " | append: section.settings.padding_bottom
  endif

  if section.settings.desktop_padding_top != "inherit"
      assign container_top_padding_classes = container_top_padding_classes | append: " " | append: section.settings.desktop_padding_top
  endif

  if section.settings.desktop_padding_bottom != "inherit"
      assign container_bottom_padding_classes = container_bottom_padding_classes | append: " " | append: section.settings.desktop_padding_bottom
  endif

  assign container_margin_classes = container_margin_classes | strip
  assign container_top_padding_classes = container_top_padding_classes | strip
  assign container_bottom_padding_classes = container_bottom_padding_classes | strip
%}


<section class="program-header {% if container_margin_classes != blank %} {{ container_margin_classes }}{% endif %}">
  <div class="program-header__title-wrapper bg-blue text-white {% if container_top_padding_classes != blank %} {{ container_top_padding_classes }}{% endif %}">
    <div class="container pb-32 tabletl:pb-xxl tabletp:flex tabletp:justify-between">
      {% if section.settings.title != blank %}
        <{{ section.settings.title_tag }} class="program-header__title mb-md  leading-[1.15] max-w-[15ch] tabletp:leading-none tabletp:mb-0 {% if section.settings.title_font_style != blank %}{{  section.settings.title_font_style  }}{% endif %}">
            {{ section.settings.title }}
        </{{ section.settings.title_tag }}>  
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="program-header__description text-18 tabletp:text-20 max-w-[44ch] tabletp:ml-xl">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
  <div class="program-header__grid-wrapper {% if container_bottom_padding_classes != blank %} {{ container_bottom_padding_classes }}{% endif %}">
    <ul class="program-header-grid container grid gap-md grid-cols-1 tabletl:flex tabletl:justify-between"
      style="--item-width: calc((100% - 20px) / 2 )">
      {%- for block in section.blocks -%}
        <li class="program-header-grid__item aspect-square text-[var(--color)] rounded relative p-20 flex flex-col justify-end h-auto flex-grow tabletl:aspect-[4/3] tabletl:w-[var(--item-width)] tabletl:p-32"
          style="--color: {{ block.settings.text_color }};">
          {% if block.settings.image != blank %}
            {% render 'lazy-image',
              image: block.settings.image,
              img_classes: 'object-cover rounded absolute top-0 left-0 h-full'
            %}
          {% endif %}
          <div class="program-header-grid__content relative">
            {% if block.settings.title != blank %}
              <h2 class="program-header-grid__title h4 leading-none mb-md">
                {{ block.settings.title }}
              </h2>  
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="program-header-grid__description text-18 font-500 mb-md tabletl:text-20">{{ block.settings.description }}</div>
            {% endif %}

            {% if block.settings.cta_klaviyo_embed != blank %}
              <button class="klaviyo_form_trigger-{{ block.settings.cta_klaviyo_embed }} {{ block.settings.button_style }} inline-block mt-md">{{ block.settings.btn_label }}</button>
              <script type="text/javascript">
                document.querySelector('.klaviyo_form_trigger-{{ block.settings.cta_klaviyo_embed }}').addEventListener('click', function (){
                  window._klOnsite = window._klOnsite || []; 
                  window._klOnsite.push(['openForm', '{{ block.settings.cta_klaviyo_embed }}']);
                });
              </script>
            {% elsif block.settings.btn_label != blank and block.settings.btn_link != blank %}
              <a
                class="{{ block.settings.button_style }} inline-block mt-md"
                href="{{ block.settings.btn_link }}"
              >
                {{ block.settings.btn_label }}
              </a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

