<s-header class="site-header text-white">
  {% if section.blocks.size > 0 %}
    <div class="announcement-bar-wrapper"
      style="{% if section.settings.announcement_text_color != blank %}color: {{ section.settings.announcement_text_color }};{% endif %}
      {% if section.settings.announcement_bg_color != blank %}background-color: {{ section.settings.announcement_bg_color }};{% endif %}" js-announcement-bar>
      <div class="announcement-bar container relative py-sm text-14">
        {%- capture carousel_options -%}
            {
              "slidesPerView": 1,
              "cssMode": true,
              "loop": true,
              "autoHeight": false,
              "autoplay": {
                "delay": 5000,
                "disableOnInteraction": false,
                "pauseOnMouseEnter": true
              },
              "navigation": {
                "enabled": true,
                "nextEl": ".swiper-button-next--{{section.id}}",
                "prevEl": ".swiper-button-prev--{{section.id}}"
              }
            }
        {%- endcapture -%}
        {% if section.blocks.size < 2 %}
          {% assign hide_nav = 'hidden' %}
        {% endif %}
        <s-carousel data-options='{{ carousel_options }}' class="announcement-bar__carousel">
          <div id="AnnouncementBar-{{ section.id }}" class="swiper w-full max-w-full flex items-center px-lg" js-carousel>
            <div class="swiper-button-prev--{{ section.id }} {{ hide_nav }} absolute z-[2] left-0 "><i class='inline-block w-md rotate-[90deg]'>{% render 'icon--caret' %}</i></div>
            <div class="swiper-button-next--{{ section.id }} {{ hide_nav }} absolute z-[2] right-0 "><i class='inline-block w-md -rotate-90'>{% render 'icon--caret' %}</i></div>
            <div class="swiper-wrapper flex">
              {% for block in section.blocks %}
                <div class="swiper-slide text-center self-center" js-carousel-slide>
                  {{ block.settings.announcement }}
                </div>
              {% endfor %} 
            </div>
          </div>
        </s-carousel>
      </div>
    </div>
  {% endif %}
  <div class="bg-blue">
    <div class="site-header__container container flex justify-between items-center text-14 h-[80px] tabletl:grid tabletl:grid-cols-4">
      <div>
        <a href="{{ routes.root_url }}" class="site-header__logo inline-block">{% render 'icon--site-logo' %}</a>
      </div>
      <div class="hidden h-full items-center justify-center tabletl:col-span-2 tabletl:flex">
        <nav class="site-header__nav relative h-full flex items-center" role="navigation" aria-label="Main navigation" js-header-nav>
          {% assign nav_linklist = linklists[section.settings.header_nav] %}
          <ul class="site-header__nav-list flex items-center justify-center gap-sm text-white" role="menubar">
            {% for parent in nav_linklist.links %}
              {% unless parent.handle == 'ensenanzas' %}
              {% if parent.links != blank %}
                {%- liquid
                  assign menu_id = forloop.index | append: '-' | append: parent.handle
                -%}
                <li class="relative" role="none">
                  <button class="site-header__nav-button flex items-center px-12 py-sm border border-transparent focus:border-white"
                    role="menuitem"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="{{ menu_id }}-dropdown"
                    tabindex="0"
                    js-header-nav-button>
                    {{ parent.title }}
                    <i class='inline-block w-md ml-xs'>{% render 'icon--caret' %}</i>
                  </button>
                </li>
              {% else %}
                <li>
                  <a href="{{ parent.url }}" role="menuitem" class="nav-link px-12 py-sm border border-transparent duration-500 tabletp:hover:opacity-50 focus:border-white" js-header-nav-link>
                    <span>{{ parent.title }}</span>
                  </a>
                </li>
              {% endif %}
              {% endunless %}
            {% endfor %}
          </ul>
          <div class="site-header__nav-dropdown dropdown" id="shared-dropdown" role="menu" js-nav-dropdown>
            {% for parent in nav_linklist.links %}
              {% unless parent.handle == 'ensenanzas' %}
              {% if parent.links != blank %}
                {%- liquid
                  assign menu_id = forloop.index | append: '-' | append: parent.handle
                -%}
              <div class="dropdown-content text-black" id="{{ menu_id }}-dropdown" js-nav-dropdown-content>
                {% for child_link in parent.links %}
                  <div class="dropdown-section">
                    <a href="{{ child_link.url }}" class="inline-block w-full px-md py-sm text-16 border border-transparent duration-500 tabletp:hover:opacity-40 focus:border-gray" role="menuitem">
                      {{ child_link.title }}
                    </a>
                    {% if child_link.links != blank %}
                      <div class="dropdown-subsection pl-md mt-xs">
                        {% for grandchild_link in child_link.links %}
                          <a href="{{ grandchild_link.url }}" class="block px-sm py-xs text-16 border border-transparent duration-500 tabletp:hover:opacity-30 focus:border-gray" role="menuitem">
                            {{ grandchild_link.title }}
                          </a>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
              {% endif %}
              {% endunless %}
            {% endfor %}
          </div>
        </nav>
      </div>
      
      <div class="flex items-center justify-end gap-sm">
        <button class="site-header__search flex h-32 w-32 items-center justify-center rounded-full border border-transparent duration-500 tabletp:hover:bg-white/10 focus:border-white" js-search-drawer-open>
          <i class='inline-block w-md'>{% render 'icon--search' %}</i>
          <span class="sr-only">Buscar</span>
        </button>
        <div class="hidden tabletl:flex">
          <a class="cursor-pointer inline-flex items-center justify-center gap-sm text-center tracking-wide rounded-full px-md py-[10px] border border-transparent duration-500  tabletp:hover:bg-white/10 focus:border-white" rel="noopener noreferrer" href="{{ routes.account_login_url }}">
            <span>Iniciar sesión</span>
          </a>
        </div>
        {% if section.settings.button_link != blank and section.settings.button_label != blank %}
          <a class="btn px-md py-[10px] text-14 shrink-0"  href="{{ section.settings.button_link }}">
            <span>{{ section.settings.button_label }}</span>
          </a>
        {% endif%}
        <button class='site-header__mobile-nav-button tabletl:hidden' id="mobile-menu-toggle">
          <span class='line'></span>
          <span class='line'></span>
          <span class='line'></span>
        </button>
      </div>
    </div>  
  </div>
</s-header>

{% schema %}
  {
    "name": "Header",
    "class": "shopify-section-header sticky top-0 bg-blue z-2",
    "settings": [
      {
        "type": "header",
        "content": "Navigation"
      },
      {
        "type": "link_list",
        "id": "header_nav",
        "label": "Navigation"
      },
      {
        "type": "header",
        "content": "Button"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button Label",
        "default": "Start Now"
      },
      {
        "type": "header",
        "content": "Announcement Bar"
      },
      {
        "type": "color",
        "id": "announcement_text_color",
        "label": "Announcement Text Color",
        "default": "#fff"
      },
      {
        "type": "color",
        "id": "announcement_bg_color",
        "label": "Announcement Bar Background Color",
        "default": "#000"
      }
    ],
    "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "richtext",
          "id": "announcement",
          "label": "Announcement Text"
        }
      ]
    }
  ]
  }
{% endschema %}
