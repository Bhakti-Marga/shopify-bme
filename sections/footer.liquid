{% assign footer_linklist = linklists[section.settings.footer_nav] %}
{% assign subfooter_linklist = linklists[section.settings.subfooter_nav] %}

<footer class="site-footer" style="background-color: #16254c;">
  <div class="text-white" style="padding: 91px 66px 90px; width: 100%;">

    {%- comment -%} TOP ZONE — nav columns {%- endcomment -%}
    <div class="site-footer__nav flex" style="gap: 44px; width: 100%;">
      {% for link in footer_linklist.links %}
        <div class="site-footer__col flex flex-col" style="gap: 16px; flex: 1;">
          <p class="site-footer__col-heading text-white" style="font-size: 14px; font-weight: 700; margin: 0;">{{ link.title }}</p>
          {% if link.links.size > 0 %}
            <ul class="site-footer__col-links" style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px;">
              {% for child_link in link.links %}
                <li>
                  <a href="{{ child_link.url }}" class="site-footer__sub-link" style="font-size: 14px; color: rgba(255,255,255,0.5); text-decoration: none;">{{ child_link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {%- comment -%} BOTTOM ZONE {%- endcomment -%}
    <div class="site-footer__bottom flex flex-col" style="gap: 20px; margin-top: 60px;">

      {%- comment -%} Row 1: legal links + social icons {%- endcomment -%}
      <div class="site-footer__subfooter flex items-center justify-between">
        <nav class="site-footer__legal-nav">
          <ul class="flex items-center" style="list-style: none; margin: 0; padding: 0; gap: 40px; flex-wrap: wrap;">
            {% for link in subfooter_linklist.links %}
              <li>
                <a href="{{ link.url }}" class="site-footer__legal-link" style="font-size: 12px; color: rgba(255,255,255,0.5); text-decoration: none;">{{ link.title }}</a>
              </li>
            {% endfor %}
            <li style="font-size: 12px; color: rgba(255,255,255,0.5);">{{ 'now' | date: '%Y' }} Todos los derechos reservados</li>
          </ul>
        </nav>
        <div class="site-footer__socials inline-flex items-center" style="gap: 16px;">
          {% render 'social-media-links' %}
        </div>
      </div>

      {%- comment -%} Row 2: legal address {%- endcomment -%}
      <p class="site-footer__legal-address" style="font-size: 12px; color: rgba(255,255,255,0.5); margin: 0;">
        {{ section.settings.legal_address }}
      </p>

    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "footer_nav",
      "label": "Footer Navigation"
    },
    {
      "type": "link_list",
      "id": "subfooter_nav",
      "label": "Subfooter Navigation"
    },
    {
      "type": "textarea",
      "id": "legal_address",
      "label": "Dirección legal / CIF",
      "default": "Asociación BHAKTI MARGA ESPAÑA, CIF G76198209. Calle Pablo Picasso, 11, 29719 Benamocarra, Málaga. Email: spain@bhaktimarga.es."
    }
  ]
}
{% endschema %}
