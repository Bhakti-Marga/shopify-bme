{% liquid
  assign container_classes = ""

  if section.settings.margin_top != "mt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.margin_top
  endif

  if section.settings.margin_bottom != "mb-0"
      assign container_classes = container_classes | append: " " | append: section.settings.margin_bottom
  endif

  if section.settings.desktop_margin_top != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_top
  endif

  if section.settings.desktop_margin_bottom != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_margin_bottom
  endif

  if section.settings.padding_top != "pt-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_top
  endif

  if section.settings.padding_bottom != "pb-0"
      assign container_classes = container_classes | append: " " | append: section.settings.padding_bottom
  endif

  if section.settings.desktop_padding_top != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_top
  endif

  if section.settings.desktop_padding_bottom != "inherit"
      assign container_classes = container_classes | append: " " | append: section.settings.desktop_padding_bottom
  endif

  assign container_classes = container_classes | strip
%}

<section class="icon-grid container {% if container_classes != blank %} {{ container_classes }}{% endif %}">
  {% if section.settings.title != blank %}
    <h2 class="h3 {{ section.settings.text_align}} leading-[1.15] mb-xl tabletl:mb-md">{{ section.settings.title }}</h2>
  {% endif %}
  {% if section.settings.subtitle != blank %}
    <h3 class="h4 {{ section.settings.text_align }} leading-[1.15] mb-xl tabletl:mb-xxl">{{ section.settings.subtitle }}</h3>
  {% endif %}
  <ul class="grid grid-cols-[var(--column-size-mobile)] tabletl:grid-cols-[var(--column-size)] gap-x-md gap-y-lg tabletl:gap-y-xl"
    style="--column-size-mobile: repeat({{ section.settings.cols_mobile }}, 1fr);
    --column-size: repeat({{ section.settings.cols_desktop }}, 1fr);">
    {% for block in section.blocks %}
      {% if block.settings.title != blank or block.settings.description != blank or block.settings.image != blank %}
        <li class="flex flex-col {{ block.settings.content_align }}">
          {% if block.settings.image != blank %}
            <div class="overflow-hidden rounded w-xxxl h-xxxl shrink-0 relative mb-md">
              {% render 'lazy-image',
                image: block.settings.image,
                img_classes: 'object-cover absolute top-0 left-0 h-full' %}
            </div>
          {% endif %}
          {% if block.settings.title != blank %}
            <{{ block.settings.title_tag }} class="leading-tight mb-sm {% if block.settings.title_font_style != blank %}{{  block.settings.title_font_style  }}{% endif %}">
              {{ block.settings.title }}
            </{{ block.settings.title_tag }}>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class="rte">
              {{ block.settings.description }}
            </div>
          {% endif %}
        </li>
      {% endif %}
    {% endfor %}
  </ul>
  <div class="flex justify-center py-12 px-20 gap-10 mt-40">
    {% if section.settings.button_text != blank and section.settings.button_url != blank %}
      <a
        href="{{ section.settings.button_url }}"
        class="hero__cta {{ section.settings.button_style }} inline-block"
      >
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>

