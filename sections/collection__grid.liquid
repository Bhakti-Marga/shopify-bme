<h2 class="collection-grid__title container h4 leading-none mb-32 font-600 text-32 tabletl:text-40 tabletl:mb-xl">{{ collection.title }}</h2>
{% render 'filter-sort', results: collection, scope: 'global' %}

{% paginate collection.products by 8 %}
<s-collection-grid role="section" class="collection-grid block container pt-lg pb-xl tabletl:pb-xxl tabletl:pt-32" data-id="{{ section.id }}">
  <div class="collection-grid__layout">
    {% if collection.products.size > 0 %}
      <ul class="collection-grid__products grid grid-cols-2 gap-md tabletl:grid-cols-4" js-products-grid>
          {% for product in collection.products %}
            <li class="collection-grid__product">
              {% render 'product-card' product: product, section_id: section.id %}
            </li>
          {% endfor %}
      </ul>
      {%- if paginate.pages > 1 -%}
        <div class="collection-grid__pagination flex justify-center mt-xl tabletl:mt-xxl" js-pagination>
          {% render 'pagination', paginate: paginate, anchor: '' %}
        </div>
      {%- endif -%}
      
    {% else %}
      <h3>No se encontraron productos</h3>
    {% endif %}

  </div>
</s-collection-grid>
{% endpaginate %}



{% schema %}
{
  "name": "Product Grid",
  "settings": [
  ]
}
{% endschema %}
