{%- liquid
  assign show_popup = false
  if section.settings.enabled
    assign show_popup = true
    assign now_ts = 'now' | date: '%s' | plus: 0
    if section.settings.start_date != blank
      assign start_ts = section.settings.start_date | date: '%s' | plus: 0
      if now_ts < start_ts
        assign show_popup = false
      endif
    endif
    if section.settings.end_date != blank
      assign end_ts = section.settings.end_date | date: '%s' | plus: 0
      if now_ts > end_ts
        assign show_popup = false
      endif
    endif
  endif
-%}

{%- if show_popup -%}

<div
  class="bm-pop-overlay"
  id="bmPopOverlay-{{ section.id }}"
  data-key="bm-popup-{{ section.id }}"
  data-delay="{{ section.settings.delay_ms | default: 1500 }}"
  data-duration="{{ section.settings.dismiss_duration }}"
></div>

<div
  class="bm-pop"
  id="bmPop-{{ section.id }}"
  role="dialog"
  aria-modal="true"
  aria-labelledby="bmPopTitle-{{ section.id }}"
  tabindex="-1"
>
  <button class="bm-pop__close" id="bmPopClose-{{ section.id }}" aria-label="Cerrar">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M2 2L12 12M12 2L2 12"/>
    </svg>
  </button>

  <div class="bm-pop__media">
    {%- if section.settings.badge_text != blank -%}
      <span class="bm-pop__badge">{{ section.settings.badge_text }}</span>
    {%- endif -%}

    {%- if section.settings.media_type == 'video' and section.settings.video_url != blank -%}
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        src="{{ section.settings.video_url }}"
        {%- if section.settings.image != blank %} poster="{{ section.settings.image | image_url: width: 960 }}"{% endif -%}
      ></video>
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 960 | image_tag: loading: 'eager', alt: section.settings.title }}
    {%- endif -%}
  </div>

  <div class="bm-pop__body">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bm-pop__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h2 class="bm-pop__title" id="bmPopTitle-{{ section.id }}">{{ section.settings.title }}</h2>

    {%- if section.settings.description != blank -%}
      <p class="bm-pop__sub">{{ section.settings.description }}</p>
    {%- endif -%}

    <div class="bm-pop__meta">
      {%- if section.settings.date_label != blank -%}
        <div class="bm-pop__meta-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="2"/>
            <path d="M3 9h18M8 3v4M16 3v4"/>
          </svg>
          <span>{{ section.settings.date_label }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.location_label != blank -%}
        <div class="bm-pop__meta-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s-7-7.5-7-13a7 7 0 1 1 14 0c0 5.5-7 13-7 13z"/>
            <circle cx="12" cy="9" r="2.5"/>
          </svg>
          <span>{{ section.settings.location_label }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <a
        class="bm-pop__cta"
        id="bmPopCta-{{ section.id }}"
        href="{{ section.settings.cta_url | default: '#' }}"
      >
        {{ section.settings.cta_text }}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    {%- endif -%}

    {%- if section.settings.dismiss_text != blank -%}
      <button class="bm-pop__dismiss" id="bmPopDismiss-{{ section.id }}">
        {{ section.settings.dismiss_text }}
      </button>
    {%- endif -%}
  </div>
</div>

{%- endif -%}

{% stylesheet %}
.bm-pop-overlay {
  position: fixed;
  inset: 0;
  background: rgba(10, 15, 30, .62);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 9998;
  opacity: 0;
  pointer-events: none;
  transition: opacity .35s ease;
}
.bm-pop-overlay.is-open {
  opacity: 1;
  pointer-events: auto;
}
.bm-pop {
  --bm-navy: #16254c;
  --bm-navy-deep: #0e1a37;
  --bm-cream: #f6f1e8;
  --bm-gold: #c9a25b;
  --bm-muted: #5a6273;
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -48%) scale(.96);
  z-index: 9999;
  width: min(960px, calc(100vw - 32px));
  max-height: calc(100vh - 32px);
  background: #fff;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 30px 80px rgba(10, 15, 30, .45), 0 2px 6px rgba(10, 15, 30, .2);
  opacity: 0;
  pointer-events: none;
  transition: opacity .4s ease, transform .45s cubic-bezier(.2, .8, .2, 1);
  display: grid;
  grid-template-columns: 1.05fr 1fr;
}
.bm-pop.is-open {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
  pointer-events: auto;
}
.bm-pop__media {
  position: relative;
  background: #0e1a37;
  min-height: 360px;
  overflow: hidden;
}
.bm-pop__media video,
.bm-pop__media img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.bm-pop__media::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(14, 26, 55, 0) 40%, rgba(14, 26, 55, .55) 100%);
  pointer-events: none;
}
.bm-pop__badge {
  position: absolute;
  top: 18px;
  left: 18px;
  z-index: 2;
  background: rgba(255, 255, 255, .92);
  color: var(--bm-navy);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  padding: 8px 12px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.bm-pop__badge::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--bm-gold);
  box-shadow: 0 0 0 0 rgba(201, 162, 91, .7);
  animation: bm-pulse 2s infinite;
}
@keyframes bm-pulse {
  0%   { box-shadow: 0 0 0 0 rgba(201, 162, 91, .7); }
  70%  { box-shadow: 0 0 0 10px rgba(201, 162, 91, 0); }
  100% { box-shadow: 0 0 0 0 rgba(201, 162, 91, 0); }
}
.bm-pop__body {
  padding: 40px 40px 36px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: linear-gradient(180deg, #fff 0%, var(--bm-cream) 100%);
}
.bm-pop__eyebrow {
  font-size: 12px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--bm-gold);
  font-weight: 600;
  margin: 0 0 14px;
}
.bm-pop__title {
  font-size: 34px;
  line-height: 1.1;
  margin: 0 0 14px;
  color: var(--bm-navy);
  font-weight: 500;
  letter-spacing: -.01em;
}
.bm-pop__sub {
  font-size: 15.5px;
  line-height: 1.55;
  color: var(--bm-muted);
  margin: 0 0 22px;
}
.bm-pop__meta {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 0 0 26px;
  border-top: 1px solid rgba(22, 37, 76, .12);
  border-bottom: 1px solid rgba(22, 37, 76, .12);
  padding: 16px 0;
}
.bm-pop__meta-row {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 14px;
  color: var(--bm-navy);
}
.bm-pop__meta-row svg {
  flex-shrink: 0;
  opacity: .85;
}
.bm-pop__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: var(--bm-navy);
  color: #fff;
  text-decoration: none;
  padding: 15px 28px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 14px;
  letter-spacing: .04em;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  transition: background .2s ease, transform .2s ease;
  align-self: flex-start;
}
.bm-pop__cta:hover {
  background: var(--bm-navy-deep);
  transform: translateY(-1px);
  color: #fff;
}
.bm-pop__cta svg {
  transition: transform .2s ease;
}
.bm-pop__cta:hover svg {
  transform: translateX(3px);
}
.bm-pop__dismiss {
  display: block;
  background: none;
  border: none;
  margin-top: 14px;
  padding: 6px 0;
  color: var(--bm-muted);
  font-size: 13px;
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 3px;
  align-self: flex-start;
}
.bm-pop__dismiss:hover {
  color: var(--bm-navy);
}
.bm-pop__close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 3;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, .92);
  color: var(--bm-navy);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background .2s ease, transform .2s ease;
}
.bm-pop__close:hover {
  background: #fff;
  transform: rotate(90deg);
}
@media (max-width: 760px) {
  .bm-pop {
    grid-template-columns: 1fr;
    width: calc(100vw - 24px);
    max-height: calc(100vh - 24px);
    overflow-y: auto;
  }
  .bm-pop__media {
    min-height: 220px;
    aspect-ratio: 4 / 3;
  }
  .bm-pop__body {
    padding: 28px 24px 28px;
  }
  .bm-pop__title {
    font-size: 26px;
  }
  .bm-pop__sub {
    font-size: 14.5px;
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  document.querySelectorAll('.bm-pop-overlay[data-key]').forEach(function (overlay) {
    var KEY = overlay.dataset.key;
    var DELAY = parseInt(overlay.dataset.delay, 10) || 1500;
    var DURATION = overlay.dataset.duration || 'permanent';
    var id = overlay.id.replace('bmPopOverlay-', '');

    var pop = document.getElementById('bmPop-' + id);
    var btnClose = document.getElementById('bmPopClose-' + id);
    var btnDismiss = document.getElementById('bmPopDismiss-' + id);
    var btnCta = document.getElementById('bmPopCta-' + id);

    if (!pop) return;

    function isDismissed() {
      if (DURATION === 'pageload') return false;
      if (DURATION === 'session') {
        return !!sessionStorage.getItem(KEY);
      }
      try {
        var val = localStorage.getItem(KEY);
        if (!val) return false;
        if (val === 'permanent') return true;
        return Date.now() < parseInt(val, 10);
      } catch (e) { return false; }
    }

    function setDismissed() {
      if (DURATION === 'pageload') return;
      try {
        if (DURATION === 'session') {
          sessionStorage.setItem(KEY, '1');
          return;
        }
        if (DURATION === 'permanent') {
          localStorage.setItem(KEY, 'permanent');
          return;
        }
        var days = { '1day': 1, '7days': 7, '30days': 30 }[DURATION] || 30;
        localStorage.setItem(KEY, (Date.now() + days * 86400000).toString());
      } catch (e) {}
    }

    function open() {
      overlay.classList.add('is-open');
      pop.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      pop.focus();
    }

    function close(dismiss) {
      overlay.classList.remove('is-open');
      pop.classList.remove('is-open');
      document.body.style.overflow = '';
      if (dismiss) setDismissed();
    }

    overlay.addEventListener('click', function () { close(true); });
    if (btnClose) btnClose.addEventListener('click', function () { close(true); });
    if (btnDismiss) btnDismiss.addEventListener('click', function () { close(true); });
    if (btnCta) btnCta.addEventListener('click', function () { close(false); });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close(true);
    });

    if (!isDismissed()) {
      setTimeout(open, DELAY);
    }
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Popup Darshan",
  "tag": "div",
  "class": "bm-popup-section",
  "settings": [
    {
      "type": "header",
      "content": "Visibilidad"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Activar popup",
      "default": false
    },
    {
      "type": "text",
      "id": "start_date",
      "label": "Fecha de inicio (AAAA-MM-DD)",
      "placeholder": "2026-01-01",
      "info": "Dejar vacío para mostrar desde el principio"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Fecha de fin (AAAA-MM-DD)",
      "placeholder": "2026-12-31",
      "info": "Dejar vacío para mostrar sin límite de fecha"
    },
    {
      "type": "number",
      "id": "delay_ms",
      "label": "Retraso antes de mostrar (ms)",
      "default": 1500,
      "info": "Milisegundos antes de que aparezca el popup al cargar la página"
    },
    {
      "type": "select",
      "id": "dismiss_duration",
      "label": "Duración del rechazo",
      "default": "pageload",
      "options": [
        { "value": "pageload", "label": "Siempre (cada carga de página)" },
        { "value": "session", "label": "Solo esta sesión" },
        { "value": "1day", "label": "1 día" },
        { "value": "7days", "label": "7 días" },
        { "value": "30days", "label": "30 días" },
        { "value": "permanent", "label": "Permanente" }
      ]
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Tipo de media",
      "default": "video",
      "options": [
        { "value": "video", "label": "Vídeo" },
        { "value": "image", "label": "Imagen" }
      ]
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "URL del vídeo",
      "default": "https://cdn.shopify.com/videos/c/o/v/06a9cabe30f1402c8b2b42d3d16c2ca1.mp4",
      "info": "URL directa del archivo de vídeo (CDN de Shopify o externo)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Se usa como poster del vídeo, o como media principal en modo imagen"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto del badge"
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Evento especial · 2026"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Darshan en Lanzarote"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Recibe la bendición de Paramahamsa Vishwananda. Una mirada de amor incondicional que abre el corazón y trae un sentido más profundo a tu vida."
    },
    {
      "type": "text",
      "id": "date_label",
      "label": "Texto de fecha",
      "default": "Sábado 21 de noviembre de 2026"
    },
    {
      "type": "text",
      "id": "location_label",
      "label": "Texto de ubicación",
      "default": "Lanzarote, Islas Canarias"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto del botón",
      "default": "Reserva tu plaza"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "URL del botón"
    },
    {
      "type": "text",
      "id": "dismiss_text",
      "label": "Texto de rechazo",
      "default": "No, gracias"
    }
  ],
  "presets": [
    {
      "name": "Popup Darshan"
    }
  ]
}
{% endschema %}
