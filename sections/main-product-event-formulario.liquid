{% comment %}
  Sección: main-product-event-formulario
  Metafields: custom.highlights (lista de metaobjects), custom.profesor, custom.programa, custom.horario, custom.comida, custom.localizacion
{% endcomment %}

<style>
  .event-grid-container {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 5rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  @media screen and (max-width: 1100px) {
    .event-grid-container {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 2rem 1.5rem;
    }
  }

  .event-info-main { min-width: 0; }

  .event-section-divider {
    margin-bottom: 4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #f0f0f0;
  }

  .event-section-divider h2 {
    font-size: 1.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: #1a1a1a;
  }

  .highlights-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
    margin-top: 2rem;
  }

  .highlight-item img {
    width: 140px;
    height: 140px;
    object-fit: contain;
  }

  .event-card-sticky {
    position: -webkit-sticky;
    position: sticky;
    top: 2rem;
    background: #ffffff;
    padding: 2.5rem;
    border-radius: 16px;
    border: 1px solid #eaeaea;
    box-shadow: 0 12px 40px rgba(0,0,0,0.06);
  }

  .sidebar-event-title { font-size: 1.6rem; margin: 0 0 0.8rem 0; font-weight: 700; }
  .sidebar-event-price { font-size: 1.4rem; color: #444; margin-bottom: 2rem; display: block; }
</style>

<div class="event-grid-container">
  
  <div class="event-info-main">
    
    <div class="event-hero-image event-section-divider">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 1400 }}" alt="{{ product.title }}" style="width:100%; border-radius:12px;">
      {% endif %}
    </div>

    <div class="event-section-divider">
      <h2>Sobre el evento</h2>
      <div class="rte">{{ product.description }}</div>
    </div>

    {% if product.metafields.custom.highlights != blank %}
      <div class="event-section-divider">
        <h2>Aspectos destacados</h2>
        <div class="highlights-grid">
          {% for highlight in product.metafields.custom.highlights.value %}
            <div class="highlight-item">
              {{ highlight | image_url: width: 150 | image_tag: alt: "Highlight icon" }}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if product.metafields.custom.profesor != blank %}
      <div class="event-section-divider">
        <h2>Profesores</h2>
        <div class="rte">
          {% for profesor in product.metafields.custom.profesor.value %}
            <div class="profesor-item" style="display: flex; gap: 20px; margin-bottom: 30px;">
              {% if profesor.foto %}
                <div class="profesor-foto" style="flex-shrink: 0;">
                  {{ profesor.foto | image_url: width: 125 | image_tag: alt: profesor.nombre.value }}
                </div>
              {% endif %}
              <div class="profesor-info">
                {% if profesor.nombre %}
                  <p style="margin-top: 0;"><strong>{{ profesor.nombre.value }}</strong></p>
                {% endif %}
                {% if profesor.descripcion_corta %}
                  <p>{{ profesor.descripcion_corta.value }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if product.metafields.custom.programa != blank %}
      <div class="event-section-divider">
        <h2>Programa</h2>
        <div class="rte">{{ product.metafields.custom.programa | metafield_tag }}</div>
      </div>
    {% endif %}

    {% if product.metafields.custom.horario != blank %}
      <div class="event-section-divider">
        <h2>Horario</h2>
        <div class="rte">{{ product.metafields.custom.horario | metafield_tag }}</div>
      </div>
    {% endif %}

    {% if product.metafields.custom.comida != blank %}
      <div class="event-section-divider">
        <h2>Comida</h2>
        <div class="rte">{{ product.metafields.custom.comida | metafield_tag }}</div>
      </div>
    {% endif %}

    {% if product.metafields.custom.localizacion != blank %}
      <div class="event-section-divider">
        <h2>Localización</h2>
        <div class="rte">
          {% for location in product.metafields.custom.localizacion.value %}
            <div class="location-item" style="margin-bottom: 20px;">
              {% if location.name %}
                <p><strong>{{ location.name.value }}</strong></p>
              {% endif %}
              {% if location.description %}
                <div>{{ location.description | metafield_tag }}</div>
              {% endif %}
              {% if location.latitude and location.longitude %}
                <a href="https://www.google.com/maps?q={{ location.latitude.value }},{{ location.longitude.value }}" 
                   target="_blank" 
                   style="display: inline-block; margin-top: 10px; color: #0066cc; text-decoration: underline;">
                  Ver en Google Maps →
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="event-sidebar-container">
    <div class="event-card-sticky">
      <h1 class="sidebar-event-title">{{ product.title }}</h1>
      <span class="sidebar-event-price">{{ product.price | money }}</span>

      <div class="app-form-wrapper">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Event Formulario",
  "blocks": [{ "type": "@app" }],
  "settings": []
}
{% endschema %}