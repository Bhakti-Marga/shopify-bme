{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id | append: product.id
  assign master_select_id = 'MasterSelect-' | append: section.id
  assign first_title  = product.metafields.event.first_title.value
  assign second_title = product.metafields.event.second_title.value
  assign third_title  = product.metafields.event.third_title.value
  assign info_btn_text = product.metafields.custom.event_info_button_text.value
  assign info_btn_page = product.metafields.custom.event_info_button_url.value
-%}

{%- capture first_content_html -%}{{ product.metafields.event.first_content | metafield_tag }}{%- endcapture -%}
{%- capture second_content_html -%}{{ product.metafields.event.second_content | metafield_tag }}{%- endcapture -%}
{%- capture third_content_html -%}{{ product.metafields.event.third_content | metafield_tag }}{%- endcapture -%}

{%- assign first_content_html = first_content_html | strip -%}
{%- assign second_content_html = second_content_html | strip -%}
{%- assign third_content_html = third_content_html | strip -%}

{%- liquid
  assign has_first  = false
  assign has_second = false
  assign has_third  = false
  if first_title != blank or first_content_html != blank
    assign has_first = true
  endif
  if second_title != blank or second_content_html != blank
    assign has_second = true
  endif
  if third_title != blank or third_content_html != blank
    assign has_third = true
  endif

  assign info_btn_url = ''
  if info_btn_page != blank
    assign info_btn_url = '/pages/' | append: info_btn_page.handle
  endif
-%}

<style>
  .product { --bm-navy:#16254c; --bm-navy-deep:#0e1a37; --bm-gold:#b89a5e; --bm-blue-link:#3671d8; --bm-rule:#e6e6e6; }
  .product { font-family: 'Avenir Next', Helvetica, Arial, sans-serif; }

  .product .product__title{
    color: var(--bm-gold);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: .01em;
    line-height: 1.1;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    margin-bottom: 0.45rem;
    margin-top: 0.0;
  }

  .product .product__price{
    color: var(--bm-navy);
    font-weight: 700;
    font-size: 1.5rem;
    margin: 1rem 0 1.25rem;
  }

  .product .product__description{
    color: var(--bm-navy);
    font-size: .9375rem;
    line-height: 1.2;
    margin-top: 1.25rem;
  }
  .product .product__description a{
    color: var(--bm-blue-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .product .form__label:has(+ .quantity__input.hidden){ display:none; }

  .product .form__label{
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .75rem;
    color: #6b6f7a;
    font-weight: 600;
    margin-bottom: .5rem;
    display: block;
  }

  .product [js-add-to-cart].btn,
  .product .btn.btn--gold[js-add-to-cart]{
    background-color: var(--bm-navy);
    color: #fff;
    border-radius: 4px;
    padding: 1rem 1.5rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-size: .9375rem;
    width: 100%;
    box-shadow: none;
    transition: background-color .2s ease;
  }
  .product [js-add-to-cart].btn:hover,
  .product [js-add-to-cart].btn:focus,
  .product [js-add-to-cart].btn:focus-visible{
    background-color: var(--bm-navy-deep);
    color: #fff;
  }
  .product [js-add-to-cart].btn:disabled{
    background-color: #c7c9cf;
    color: #fff;
    cursor: not-allowed;
  }

.product .quantity{
  border: none;
  margin-bottom: .5rem;
  display: inline-flex;
  align-items: center;
  gap: .5rem;
}

  .product .product-option__select,
  .product select{
    border: 1px solid var(--bm-rule);
    border-radius: 4px;
    background-color: #fff;
    padding: .875rem 1rem;
    font-size: .9375rem;
    color: var(--bm-navy);
    width: 100%;
    margin-bottom: .75rem;
  }

  .product #infiniteoptions-container .product-form__text-input input{
    border: 1px solid var(--bm-rule);
    border-radius: 4px;
    padding: .875rem 1rem;
    font-weight: 500;
    color: var(--bm-navy);
    text-transform: none;
  }
  .product #infiniteoptions-container .product-form__text-input input::placeholder{
    color: #9ca3af;
    text-transform: none;
    font-weight: 500;
  }

  .product .product__images .swiper-slide img{ border-radius: 6px; }

  

  .product__info-btn {
    display: inline-block;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    padding: .875rem 1.5rem;
    background: transparent;
    color: var(--bm-navy);
    border: 2px solid var(--bm-navy);
    border-radius: 4px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-size: .875rem;
    text-decoration: none;
    transition: background-color .2s ease, color .2s ease;
  }
  .product__info-btn:hover {
    background: var(--bm-navy);
    color: #fff;
  }

  .product__content-blocks {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--bm-rule);
  }
  .product__content-block {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--bm-rule);
  }
  .product__content-block:last-child {
    border-bottom: none;
  }
  .product__content-block h2 {
    color: var(--bm-navy);
    font-weight: 700;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: .02em;
  }
  .product__content-block div {
    color: var(--bm-navy);
    font-size: .9375rem;
    line-height: 1.6;
  }

  @media (min-width: 64rem) {
    .product .product__images {
      position: sticky;
      top: var(--header-height);
      align-self: start;

    }
    .product .product__information {
      position: static;
    }
  }
</style>

{%- capture carousel_options -%}
  {
    "slidesPerView": "auto",
    "freeMode": true,
    "touchRatio": 1,
    "momentum": true,
    "mousewheel": {
      "forceToAxis": true
    },
    "loop": false,
    "spaceBetween": 16,
    "pagination": {
      "el": ".swiper-pagination",
      "type": "bullets",
      "clickable": true
    }
  }
{%- endcapture -%}

<s-product role="section" class="product block container py-md tabletl:py-xl" data-section-id="{{ section.id }}">
  <a class="skip-to-content-link sr-only" href="#ProductInfo-{{ section.id }}">Skip to product information</a>

  <div class="product__layout tabletl:grid tabletl:grid-cols-2 tabletl:gap-md">

    <div class="product__images">
      <s-carousel data-init="belowLaptop" data-options='{{ carousel_options }}'>
        <div id="ProductMainImages" class="swiper w-full pb-[50px]" js-carousel>
          <div class="swiper-wrapper tabletl:grid tabletl:grid-cols-2 tabletl:gap-md">
            {% for media in product.media %}
              {% assign slide_classes = 'relative z-1 overflow-hidden' %}
              {% assign index_mod_3 = forloop.index | modulo: 3 %}
              {% if index_mod_3 == 1 %}
                {% assign slide_classes = slide_classes | append: ' tabletl:col-span-2' %}
              {% elsif index_mod_3 == 2 or index_mod_3 == 0 %}
                {% assign slide_classes = slide_classes | append: ' tabletl:col-span-1' %}
              {% endif %}
              {% case media.media_type %}
                {% when 'image' %}
                  <div class="swiper-slide {{ slide_classes }}" js-carousel-slide>
                    {% render 'lazy-image',
                      image: media,
                      picture_classes: 'h-full',
                      img_classes: 'object-cover h-full rounded'
                    %}
                  </div>
                {% when 'video' %}
                  <div class="swiper-slide {{ slide_classes }}" js-carousel-slide>
                    {{ media | video_tag: controls: true, autoplay: false, loop: true, mute: false, class: 'w-full h-full object-cover block' }}
                  </div>
                {% when 'external_video' %}
                  <div class="swiper-slide {{ slide_classes }}" js-carousel-slide>
                    {{ media | external_video_tag }}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
          <div class="swiper-pagination tabletl:hidden"></div>
        </div>
      </s-carousel>
    </div><!-- .product__images -->

    <div class="product__information h-[min-content] pt-0 pb-lg tabletl:pt-md tabletl:pb-xl tabletl:px-xxl tabletl:sticky tabletl:top-[var(--header-height)]">

      <h1 class="product__title h5 leading-tight mb-lg">{{ product.title }}</h1>

      {%- if product.metafields.event.category != blank -%}
        <p style="font-size:.9375rem;margin-bottom:.5rem;">
          <span class="form__label" style="display:inline;margin-bottom:0;">Categoría:</span>
          <span style="color:var(--bm-navy);font-weight:700;">{{ product.metafields.event.category.value }}</span>
        </p>
      {%- endif -%}

      {%- if product.description != blank -%}
        <div class="product__description text-16 mb-lg tabletl:text-18">
          {{ product.description }}
        </div>
      {%- endif -%}

      {%- assign locations = product.metafields.custom.localizacion.value -%}
      {%- if locations != blank -%}
        <div class="mb-sm">
          {%- for loc in locations -%}
            <p style="font-size:.9375rem;">
              <span class="form__label" style="display:inline;margin-bottom:0;">Localización:</span>
              <span style="color:var(--bm-navy);font-weight:700;">{{ loc.name }}</span>
              <a href="https://www.google.com/maps/search/{{ loc.name | url_encode }}"
                 target="_blank" rel="noopener"
                 style="display:inline-flex;align-items:center;margin-left:.4rem;color:var(--bm-blue-link);"
                 title="Ver en Google Maps">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </a>
            </p>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if product.metafields.event.consents != blank -%}
        <p style="font-size:.9375rem;margin-bottom:.5rem;">
          <span class="form__label" style="display:inline;margin-bottom:0;">Características:</span>
          <span style="color:var(--bm-navy);font-weight:700;">{{ product.metafields.event.consents.value }}</span>
        </p>
      {%- endif -%}

      {%- if product.metafields.event.event_start != blank -%}
        <div class="mb-sm">
          <p style="font-size:.9375rem;">
            <span class="form__label" style="display:inline;margin-bottom:0;">Inicio:</span>
            <span style="color:var(--bm-navy);font-weight:700;">{{ product.metafields.event.event_start.value | date: "%d %b %Y, %H:%M" }}</span>
          </p>
          {%- if product.metafields.event.event_end != blank -%}
            <p style="font-size:.9375rem;margin-top:.25rem;">
              <span class="form__label" style="display:inline;margin-bottom:0;">Fin:</span>
              <span style="color:var(--bm-navy);font-weight:700;">{{ product.metafields.event.event_end.value | date: "%d %b %Y, %H:%M" }}</span>
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="mb-sm" js-price>
        <p style="font-size:.9375rem;">
          <span class="form__label" style="display:inline;margin-bottom:0;">Precio:</span>
          <span style="color:var(--bm-navy);font-weight:700;">{{ current_variant.price | money }}</span>
        </p>
      </div>

      {%- assign profesores = product.metafields.custom.profesores.value -%}
      {%- if profesores != blank -%}
        <div class="mb-lg" style="border-bottom:1px solid var(--bm-rule);padding-bottom:1rem;">
          <span class="form__label">Profesor/es:</span>
          {%- for prof in profesores -%}
            <div style="display:flex;align-items:flex-start;gap:1rem;margin-top:.75rem;">
              {%- if prof.photo != blank -%}
                {{ prof.photo | image_url: width: 80 | image_tag: style: 'width:60px;height:60px;object-fit:cover;border-radius:50%;flex-shrink:0;' }}
              {%- endif -%}
              <div>
                <p style="color:var(--bm-navy);font-weight:700;font-size:1rem;">{{ prof.name }}</p>
                {%- if prof.presentacion != blank -%}
                  <div style="color:#6b6f7a;font-size:.875rem;margin-top:.25rem;line-height:1.5;">{{ prof.presentacion | metafield_tag }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', js-product-form: true -%}

        {% render 'master-variant-select',
          variants: product.variants,
          id: master_select_id,
          current_variant: current_variant
        %}

        {% unless product.has_only_default_variant %}
          <product-options class="no-js-hidden block" data-product='ProductJSON' data-master-select-id="{{ master_select_id }}" data-enable-history-state>
            {% for option in product.options_with_values %}
              {% render 'product-option-selector',
                option: option,
                type: 'select',
                section_id: section.id,
                product_id: product.id
              %}
            {% endfor %}
          </product-options>
        {% endunless %}

<div style="display:flex;align-items:center;gap:1rem;margin-bottom:.75rem;">
  <label class="form__label" style="margin-bottom:0;display:inline;" for="Quantity-{{ section.id }}">Cantidad:</label>
  <quantity-input style="display:inline-flex;align-items:center;gap:.1rem;">
    <button class="quantity__button" name="minus" type="button"
      style="width:18px;height:28px;border:none;background:transparent;font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;"
      aria-label="Disminuir cantidad">&minus;</button>
    <input class="quantity__input"
           style="width:20px;text-align:center;border:1px solid var(--bm-rule);border-radius:4px;padding:.25rem;font-size:.9375rem;"
           type="number" name="quantity" id="Quantity-{{ section.id }}"
           min="1" value="1" form="{{ product_form_id }}">
    <button class="quantity__button" name="plus" type="button"
      style="width:18px;height:28px;border:none;background:transparent;font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;"
      aria-label="Aumentar cantidad">&plus;</button>
  </quantity-input>
</div>


        {%- for block in section.blocks -%}
          {% render block %}
        {%- endfor -%}

        <button
          class="btn btn--gold py-md w-full uppercase relative"
          type="submit"
          {% unless current_variant.available %} disabled {% endunless %}
          js-add-to-cart>
          <loading-spinner style="--size: 3rem; --bg-opacity: 100%;"></loading-spinner>
          {% if current_variant.available %} Añadir al carrito {% else %} Agotado {% endif %}
        </button>
        <p class="hidden" js-error-message></p>

      {%- endform -%}

    </div><!-- .product__information -->

  </div><!-- .product__layout -->

  {%- if has_first or has_second or has_third -%}
    <div class="product__content-blocks">

      {%- if has_first -%}
        <div class="product__content-block">
          {%- if first_title != blank -%}<h2>{{ first_title }}</h2>{%- endif -%}
          {%- if first_content_html != blank -%}<div>{{ first_content_html }}</div>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if has_second -%}
        <div class="product__content-block">
          {%- if second_title != blank -%}<h2>{{ second_title }}</h2>{%- endif -%}
          {%- if second_content_html != blank -%}<div>{{ second_content_html }}</div>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if has_third -%}
        <div class="product__content-block">
          {%- if third_title != blank -%}<h2>{{ third_title }}</h2>{%- endif -%}
          {%- if third_content_html != blank -%}<div>{{ third_content_html }}</div>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if info_btn_text != blank and info_btn_url != blank -%}
        <a class="product__info-btn" href="{{ info_btn_url }}">
          {{ info_btn_text }}
        </a>
      {%- endif -%}

    </div>
  {%- endif -%}

  <script type="application/json" id="ProductJSON">{{ product | json }}</script>

</s-product>

{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {%- if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif -%}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product Evento Formulario",
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}